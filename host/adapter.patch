+
+test("Paseo historical acceptance shows its timestamp and does not override a current login error", async (t) => {
+  const f = fixture(t, { status: { state: { acceptance: { checkedAt: "2026-10-10T01:02:03.000Z", providers: [{ provider: "codex", passed: true }] } }, providers: [{ provider: "codex", chatVerified: true, authentication: "login_required" }] } });
+  await f.settle();
