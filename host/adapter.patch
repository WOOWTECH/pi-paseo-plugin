index 0000000..a90decd
--- /dev/null
+++ b/lib/plugin-lifecycle.ts
@@ -0,0 +1,72 @@
+import { existsSync } from "node:fs";
+import { homedir } from "node:os";
+import { join, resolve } from "node:path";
+import { applyPaseoPackageLifecycle, createPaseoOnboarding, loadPaseoHostApi, restorePaseoPlugin } from "./paseo-plugin";
+import { PASEO_PACKAGE_NAME, type PaseoHostApi, type PaseoLifecycleAction, type PaseoPackageRef } from "./paseo-plugin-lifecycle";
+import { readRegularFileText } from "./regular-file";
+
+/** Generic package route seam; integration discovery stays outside the route. */
+export async function notifyPluginPackageChange(
+  action: PaseoLifecycleAction, cwd: string, before: PaseoPackageRef[], after: PaseoPackageRef[],
+  successful: Pick<PaseoPackageRef, "source" | "scope">[], preloaded?: PaseoHostApi,
+) {
+  const paseo = await applyPaseoPackageLifecycle(action, cwd, before, after, successful, preloaded);
+  return paseo ? { paseo } : {};
+}
+
+/** The registration is service intent; runtime desiredEnabled can lag behind it. */
+function priorServiceEnabled(runtimeEnabled: boolean): boolean {
+  // Match the plugin's locations() without reading state, pairing or account files.
+  const home = resolve(process.env.HOME || homedir());
+  const agentDir = resolve(process.env.PI_CODING_AGENT_DIR || process.env.PI_AGENT_DATA_DIR || (existsSync("/data/pi-agent") ? "/data/pi-agent" : join(home, ".pi/agent")));
+  const stateDir = resolve(process.env.PI_PASEO_STATE_DIR || join(agentDir, "pi-paseo"));
+  const raw = readRegularFileText(join(stateDir, "host-registration.json"), 64 * 1024);
+  if (raw === undefined) return runtimeEnabled;
+  const registration = JSON.parse(raw) as Record<string, unknown>;
+  if (!registration || typeof registration !== "object" || Array.isArray(registration) || (registration.enabled !== undefined && typeof registration.enabled !== "boolean")) {
+    throw new Error("Paseo registration unavailable");
+  }
+  return typeof registration.enabled === "boolean" ? registration.enabled : runtimeEnabled;
+}
+
+/** Stop the last binding, or migrate supervision before deleting its modules. */
+export async function preparePluginPackageRemoval(cwd: string, packages: PaseoPackageRef[], source: string, scope: "global" | "project") {
+  const target = packages.find((pkg) => pkg.packageName === PASEO_PACKAGE_NAME && pkg.source === source && pkg.scope === scope);
+  if (!target) return undefined;
+  const api = await loadPaseoHostApi(target, true);
+  const paseoPackages = packages.filter((pkg) => pkg.packageName === PASEO_PACKAGE_NAME);
+  const remaining = paseoPackages.find((pkg) => !pkg.disabled && (pkg.source !== source || pkg.scope !== scope));
+  const hooks = { createOnboarding: () => createPaseoOnboarding(cwd) };
+  let wasEnabled = false;
+  let recovery = api;
+  try {
+    wasEnabled = priorServiceEnabled((await api.status()).enabled === true);
+    if (remaining) {
+      recovery = await loadPaseoHostApi(remaining);
+      // restore honors a manual pause; when enabled, startSupervisor waits for
+      // the old package's supervisor to exit before starting the remaining one.
+      await recovery.restore(hooks);
+    } else {
+      await api.lifecycle({ action: "remove", cwd, source, scope, packages: [] }, hooks);
+      const status = await api.status();
+      if (status.enabled === true || (status.daemon as { running?: boolean } | undefined)?.running === true) throw new Error("Cleanup incomplete");
+    }
+  } catch {
+    throw new Error("Paseo 服務尚未停止；請先在設定頁停止服務，再移除插件。");
+  }
+  return {
+    api: recovery,
+    async recover() {
+      if (remaining) {
+        await recovery.restore(hooks);
+      } else if (wasEnabled && !target.disabled) {
+        // Undo only our temporary cleanup pause, never a pre-existing Stop.
+        await recovery.lifecycle({ action: "enable", cwd, source, scope, packages: paseoPackages }, hooks);
+      }
+    },
+  };
+}
+
+export function restorePluginPackages(): Promise<void> {
+  return restorePaseoPlugin();
+}
