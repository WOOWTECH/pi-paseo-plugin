diff --git a/components/PaseoPluginPanel.tsx b/components/PaseoPluginPanel.tsx
new file mode 100644
index 0000000..7582d1c
--- /dev/null
+++ b/components/PaseoPluginPanel.tsx
@@ -0,0 +1,198 @@
+"use client";
+
+import { useCallback, useEffect, useRef, useState } from "react";
+import { ConfigButton, ConfigDetailActions, ConfigDetailGrid, ConfigDetailGridRow, ConfigFooterStatus, ConfigSectionTitle } from "./SettingsUi";
+import { PASEO_APP_URL, PASEO_PROVIDERS, paseoModelCatalog, paseoProviderLabel, paseoPublicStatus, safePaseoPairUrl, type PaseoModelCatalog, type PaseoPublicStatus } from "@/lib/paseo-ui";
+
+const STATUS_FRESH_MS = 15_000;
+
+const PHASE_LABELS: Record<string, string> = {
+  restart_required: "需要重新啟動；請先停止 Paseo 服務，再按「啟動服務」。",
+  disabled: "已停用", idle: "等待啟動", installing: "下載安裝中", activating: "正在啟動", starting: "正在啟動",
+  not_installed: "尚未安裝", stopped: "服務已停止", ready: "服務已啟動", running: "服務已啟動", paired: "已配對", complete: "服務已就緒", error: "需要處理", failed: "需要處理",
+};
+
+async function request(cwd: string, action?: string, config?: Record<string, string>, provider?: string): Promise<Record<string, unknown>> {
+  const response = action
+    ? await fetch("/api/plugin-paseo", { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify({ cwd, action, ...(config ? { config } : {}), ...(provider ? { provider } : {}) }), cache: "no-store" })
+    : await fetch(`/api/plugin-paseo${cwd ? `?cwd=${encodeURIComponent(cwd)}` : ""}`, { cache: "no-store" });
+  let result: Record<string, unknown>;
+  try { result = await response.json(); } catch { throw new Error("Paseo 操作暫時無法完成。請重新登入 Pi Web 後重試。"); }
+  if (!result || typeof result !== "object" || Array.isArray(result)) throw new Error("Paseo 操作暫時無法完成。");
+  if (!response.ok || result.error) throw new Error(typeof result.error === "string" ? result.error : "Paseo 操作暫時無法完成。");
+  return result;
+}
+
+export function PaseoPluginPanel({ cwd = "", disabled = false }: { cwd?: string; disabled?: boolean }) {
+  const [status, setStatus] = useState<PaseoPublicStatus>({});
+  const [busy, setBusy] = useState("");
+  const [error, setError] = useState("");
+  const [notice, setNotice] = useState("");
+  const [pairUrl, setPairUrl] = useState<string | null>(null);
+  const [checks, setChecks] = useState<Array<{ name: string; status: string; message?: string }>>([]);
+  const [name, setName] = useState("");
+  const [catalogs, setCatalogs] = useState<PaseoModelCatalog[]>([]);
+  const [statusCurrent, setStatusCurrent] = useState(false);
+  const requestVersions = useRef({ workspace: 0, refresh: 0, action: 0, mutation: false, pendingRefresh: 0 });
+  const nameEdited = useRef(false);
+  const lastStatusAt = useRef(0);
+
+  const refresh = useCallback(async () => {
+    const versions = requestVersions.current;
+    if (versions.mutation || versions.pendingRefresh === versions.refresh && versions.pendingRefresh !== 0) return;
+    const workspace = versions.workspace, version = ++versions.refresh;
+    versions.pendingRefresh = version;
+    try {
+      const next = paseoPublicStatus(await request(cwd));
+      if (workspace !== versions.workspace || version !== versions.refresh) return;
+      lastStatusAt.current = Date.now();
+      setStatus(next);
+      setStatusCurrent(true);
+      setError("");
+      if (!nameEdited.current) setName(next.configuration?.name ?? "");
+    } catch (failure) {
+      if (workspace !== versions.workspace || version !== versions.refresh) return;
+      setStatusCurrent(false);
+      setPairUrl(null);
+      setError(failure instanceof Error ? failure.message : "Paseo 狀態暫時無法取得。");
+    } finally {
+      if (workspace === versions.workspace && versions.pendingRefresh === version) versions.pendingRefresh = 0;
+    }
+  }, [cwd]);
+
+  useEffect(() => {
+    const versions = requestVersions.current;
+    versions.workspace++;
+    versions.action++;
+    versions.mutation = false;
+    nameEdited.current = false;
+    lastStatusAt.current = 0;
+    setPairUrl(null); setChecks([]); setCatalogs([]); setName(""); setStatus({}); setStatusCurrent(false); setBusy(""); setError(""); setNotice("");
+    void refresh();
+    return () => { versions.workspace++; versions.refresh++; versions.action++; };
+  }, [refresh, disabled]);
+  useEffect(() => {
+    if (disabled || status.packageEnabled === false) return;
+    const timer = setInterval(() => {
+      if (lastStatusAt.current && Date.now() - lastStatusAt.current >= STATUS_FRESH_MS) setStatusCurrent(false);
+      if (!document.hidden) void refresh();
+    }, 5000);
+    return () => clearInterval(timer);
+  }, [disabled, status.packageEnabled, refresh]);
+  useEffect(() => { if (disabled || status.packageEnabled === false || status.enabled === false || !statusCurrent) { setPairUrl(null); setCatalogs([]); } }, [disabled, status.packageEnabled, status.enabled, statusCurrent]);
+
+  const action = async (kind: "activate" | "disable" | "diagnose" | "pair" | "config" | "models", provider?: string) => {
+    const versions = requestVersions.current;
+    if (versions.mutation) return;
+    versions.mutation = !["diagnose", "models"].includes(kind);
+    const workspace = versions.workspace, version = ++versions.action;
+    // A pre-action poll must not replace the snapshot fetched after a write.
+    versions.refresh++;
+    const current = () => workspace === versions.workspace && version === versions.action;
+    setBusy(kind);
+    if (kind === "pair" || kind === "disable") setPairUrl(null);
+    setError("");
+    setNotice("");
+    try {
+      const config = kind === "config" ? { ...(name.trim() ? { name: name.trim() } : {}) } : undefined;
+      const result = await request(cwd, kind, config, provider);
+      if (!current()) return;
+      if (kind === "pair") {
+        const url = safePaseoPairUrl(result.url);
+        if (!url) throw new Error("尚未取得有效的官方配對連結。");
+        setPairUrl(url);
+        setNotice("已產生配對連結。請開啟 Paseo 完成配對；配對連結只保留在這個畫面。");
+      } else if (kind === "models" && provider) {
+        const catalog = paseoModelCatalog(result, provider);
+        setCatalogs((current) => [...current.filter((item) => item.provider !== provider), catalog]);
+        setNotice("已取得 Paseo 實際模型與模式；請在 Paseo 選擇後開始對話。");
+      } else if (kind === "diagnose") {
+        const entries = Array.isArray(result.checks) ? result.checks : [];
+        setChecks(entries.flatMap((entry) => {
+          if (!entry || typeof entry !== "object") return [];
+          const value = entry as Record<string, unknown>;
+          return typeof value.name === "string" && typeof value.status === "string"
+            ? [{ name: value.name, status: value.status, ...(typeof value.message === "string" ? { message: value.message } : {}) }]
+            : [];
+        }));
+        setNotice("診斷已更新。提供者仍需各自完成登入與實際對話驗證。");
+      } else {
+        if (kind === "config") nameEdited.current = false;
+        setNotice(kind === "config" ? "設定已儲存。" : kind === "disable" ? "已要求停止 Paseo 服務。" : "Paseo 服務已排入背景啟動；可在此頁查看狀態並配對。" );
+      }
+      versions.mutation = false;
+      await refresh();
+    } catch (failure) {
+      if (!current()) return;
+      setError(failure instanceof Error ? failure.message : "Paseo 操作尚未完成。");
+    } finally { if (current()) { versions.mutation = false; setBusy(""); } }
+  };
+
+  const packageDisabled = disabled || status.packageEnabled === false;
+  const serviceReady = statusCurrent && !packageDisabled && status.enabled !== false && status.daemon?.healthy === true && status.phase !== "restart_required";
+  const mutationBusy = Boolean(busy) && !["diagnose", "models"].includes(busy);
+  return (
