+import assert from "node:assert/strict";
+import fs from "node:fs";
+import { fileURLToPath } from "node:url";
+import { setImmediate } from "node:timers/promises";
+import vm from "node:vm";
+import test from "node:test";
+import * as jsx from "react/jsx-runtime";
+import ts from "typescript";
+import * as ui from "../lib/paseo-ui.ts";
+
+const panelPath = fileURLToPath(new URL("./PaseoPluginPanel.tsx", import.meta.url));
+
+// Run the actual panel and callbacks with a small hook scheduler. Fetch and
+// timers are isolated; JSX retains the real button props and displayed text.
+function fixture(t, { status = {}, fetch } = {}) {
+  const hooks = [], effects = [], requests = [], timers = new Map();
+  let now = Date.now();
+  let cursor = 0, tree, props = { cwd: "/fixture/project" }, nextTimer = 0;
+  const same = (a, b) => a && b && a.length === b.length && a.every((value, index) => Object.is(value, b[index]));
+  const react = {
+    useState(initial) {
+      const index = cursor++;
+      hooks[index] ??= { value: typeof initial === "function" ? initial() : initial };
+      return [hooks[index].value, (value) => { hooks[index].value = typeof value === "function" ? value(hooks[index].value) : value; }];
+    },
+    useRef(value) { const index = cursor++; hooks[index] ??= { current: value }; return hooks[index]; },
+    useCallback(callback, dependencies) {
+      const index = cursor++;
+      if (!same(hooks[index]?.dependencies, dependencies)) hooks[index] = { callback, dependencies };
+      return hooks[index].callback;
+    },
+    useEffect(effect, dependencies) {
+      const index = cursor++;
+      if (!same(hooks[index]?.dependencies, dependencies)) {
+        const previous = hooks[index];
+        hooks[index] = { dependencies };
+        effects.push(() => { previous?.cleanup?.(); hooks[index].cleanup = effect(); });
+      }
+    },
+  };
+  const blocks = Object.fromEntries(["ConfigButton", "ConfigDetailActions", "ConfigDetailGrid", "ConfigDetailGridRow", "ConfigFooterStatus", "ConfigSectionTitle"].map((name) => [name, name]));
+  const sandbox = vm.createContext({
+    fetch: async (url, options) => { requests.push({ url, options }); return fetch ? fetch(url, options) : Response.json(status); },
+    document: { hidden: false }, navigator: {}, console, AbortController, Date: { now: () => now },
+    setInterval(callback) { const id = ++nextTimer; timers.set(id, callback); return id; },
+    clearInterval(id) { timers.delete(id); },
+  });
+  const code = ts.transpileModule(fs.readFileSync(panelPath, "utf8"), { compilerOptions: { module: ts.ModuleKind.CommonJS, target: ts.ScriptTarget.ES2022, jsx: ts.JsxEmit.ReactJSX, esModuleInterop: true }, fileName: panelPath }).outputText;
+  const loaded = { exports: {} };
+  vm.runInContext(`(function(require,module,exports){${code}\n})`, sandbox, { filename: panelPath })((specifier) => {
+    const modules = { react, "react/jsx-runtime": jsx, "next/link": { default: "Link", __esModule: true }, "./SettingsUi": blocks, "@/lib/paseo-ui": ui };
+    assert.ok(Object.hasOwn(modules, specifier), specifier);
+    return modules[specifier];
+  }, loaded, loaded.exports);
+  const { PaseoPluginPanel } = loaded.exports;
+  function render(nextProps = {}) {
+    props = { ...props, ...nextProps };
+    cursor = 0;
+    tree = PaseoPluginPanel(props);
+    for (const effect of effects.splice(0)) effect();
+    return tree;
+  }
+  function elements(node) {
+    if (Array.isArray(node)) return node.flatMap((child) => elements(child));
+    if (!node || typeof node !== "object") return [];
+    return [node, ...elements(node.props?.children)];
+  }
+  function text(node) {
+    if (Array.isArray(node)) return node.map((child) => text(child)).join("");
+    if (node === null || node === undefined || typeof node === "boolean") return "";
+    if (typeof node !== "object") return String(node);
+    return (node.props?.summary ?? "") + text(node.props?.children);
+  }
+  function button(label) {
+    const found = elements(tree).find((node) => node.type === "ConfigButton" && text(node) === label);
+    assert.ok(found, `Button ${label} exists`);
+    return found;
+  }
+  async function settle() { await setImmediate(); render(); await setImmediate(); render(); }
+  t.after(() => { for (const hook of hooks) hook?.cleanup?.(); });
+  render();
+  return { render, text: () => text(tree), button, elements: () => elements(tree), settle, requests, timers, advance: (ms) => { now += ms; } };
+}
+
+test("Paseo Stop stays available while a paused daemon is still running", async (t) => {
+  const f = fixture(t, { status: { enabled: false, packageEnabled: true, phase: "disabled", daemon: { running: true, healthy: true } } });
+  await f.settle();
