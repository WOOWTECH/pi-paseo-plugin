index 0000000..342a54b
--- /dev/null
+++ b/e2e/paseo-mobile-scroll-runner.mjs
@@ -0,0 +1,37 @@
+import {spawn} from 'node:child_process';
+import {once} from 'node:events';
+import {mkdtempSync,mkdirSync,rmSync,writeFileSync} from 'node:fs';
+import {createServer} from 'node:net';
+import {tmpdir} from 'node:os';
+import {join} from 'node:path';
+import {setTimeout as delay} from 'node:timers/promises';
+
+// Production build, isolated HOME and agent store; never use operator settings.
+const home=mkdtempSync(join(tmpdir(),'paseo-scroll-e2e-'));
+if(!process.env.PI_PASEO_PLUGIN_ROOT)throw new Error('PI_PASEO_PLUGIN_ROOT is required for the Settings fixture');
+mkdirSync(join(home,'agent'),{recursive:true});
+writeFileSync(join(home,'agent','settings.json'),JSON.stringify({packages:[process.env.PI_PASEO_PLUGIN_ROOT]}));
+mkdirSync(join(home,'agent','pi-paseo'),{recursive:true});
+writeFileSync(join(home,'agent','pi-paseo','host-registration.json'),JSON.stringify({enabled:false}));
+const probe=createServer();probe.listen(0,'127.0.0.1');await once(probe,'listening');
+const port=probe.address().port;await new Promise(resolve=>probe.close(resolve));
+const base=`http://127.0.0.1:${port}`;
+const env={...process.env,HOME:home,PI_CODING_AGENT_DIR:join(home,'agent'),PI_WEB_PASSWORD:'',PI_OMNIGENT_PLUGIN_ROOT:'',PI_PASEO_DISCOVERY_ONLY:'1',PI_PASEO_SKIP_POSTINSTALL:'1',NEXT_TELEMETRY_DISABLED:'1'};
+const server=spawn(process.execPath,['node_modules/next/dist/bin/next','start','-H','127.0.0.1','-p',String(port)],{env,stdio:['ignore','ignore','inherit']});
+const stopped=once(server,'exit');
+try {
+  let ready=false;
+  for(let i=0;i<120&&server.exitCode===null;i++){
+    if(await fetch(base).then(r=>r.ok,()=>false)){ready=true;break;}
+    await delay(250);
+  }
+  if(!ready)throw new Error('Production server did not become ready');
+  const child=spawn(process.execPath,['e2e/paseo-mobile-scroll.mjs'],{env:{...env,PI_WEB_E2E_URL:base},stdio:'inherit'});
+  const [code]=await once(child,'exit');
+  if(code!==0)throw new Error('Paseo scroll regression failed');
+} finally {
+  server.kill('SIGTERM');
+  const timeout=setTimeout(()=>server.kill('SIGKILL'),5000);
+  await stopped;clearTimeout(timeout);
+  rmSync(home,{recursive:true,force:true});
+}
