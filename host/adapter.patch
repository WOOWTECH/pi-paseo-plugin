+import { serializeByKey } from "./key-serializer";
+
+/** Startup and package writes share a chain across separately bundled routes. */
+export function serializePluginPackageOperation<T>(task: () => Promise<T>): Promise<T> {
+  return serializeByKey(Symbol.for("pi-web:plugin-package-lifecycle"), "packages", task);
+}
