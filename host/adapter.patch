@@ -0,0 +1,96 @@
+import { NextResponse } from "next/server";
+import { readJsonObject, RequestBodyError } from "@/lib/json-request";
+import { homedir } from "node:os";
+import { statSync } from "node:fs";
+import { isAbsolute } from "node:path";
+import { getAllowedFileRoots, isExistingFilePathAllowed } from "@/lib/file-access";
+import { hasJsonContentType, isApiRequestAllowed } from "@/lib/request-security";
+import { configuredPaseoPackages, loadPaseoHostApi } from "@/lib/paseo-plugin";
+import { paseoLifecycleResult } from "@/lib/paseo-plugin-lifecycle";
+import { serializePluginPackageOperation } from "@/lib/plugin-package-lock";
+import { paseoDiagnosticChecks, paseoModelCatalog, paseoPublicStatus, readPaseoConfig, safePaseoPairUrl } from "@/lib/paseo-ui";
+
+export const dynamic = "force-dynamic";
+export const runtime = "nodejs";
+const headers = { "Cache-Control": "private, no-store", "Referrer-Policy": "no-referrer" };
+const MAX_BODY_BYTES = 16 * 1024;
+
+function validCwd(cwd: unknown): boolean {
+  return cwd === undefined || (typeof cwd === "string" && cwd.length <= 4096 && !/[\u0000-\u001f\u007f]/.test(cwd) && (cwd === "" || isAbsolute(cwd)));
+}
+
+function response(value: unknown, status = 200) {
+  return NextResponse.json(value, { status, headers });
+}
+
+async function context(cwd: unknown) {
+  const directory = typeof cwd === "string" && cwd ? cwd : process.env.PI_PASEO_CWD || homedir();
+  if (!validCwd(directory)) return null;
+  const roots = await getAllowedFileRoots();
+  if (!isExistingFilePathAllowed(directory, roots)) return null;
+  if (!statSync(directory).isDirectory()) return null;
+  const packages = configuredPaseoPackages(directory);
+  const target = packages.find((pkg) => !pkg.disabled) ?? packages[0];
+  if (!target) return null;
+  return { cwd: directory, packages, target, api: target.disabled ? null : await loadPaseoHostApi(target) };
+}
+
+export async function GET(req: Request) {
+  if (!isApiRequestAllowed(req)) return response({ error: "Untrusted API request" }, 403);
+  try {
+    const cwd = new URL(req.url).searchParams.get("cwd") ?? undefined;
+    if (!validCwd(cwd)) return response({ error: "Invalid working directory" }, 400);
+    const current = await context(cwd);
+    if (!current) return response({ error: "請先在插件設定安裝 Paseo，並選擇可存取的工作目錄。" }, 404);
+    return response(current.api ? paseoPublicStatus({ ...await current.api.status(), packageEnabled: true, packageInstalled: true }) : { phase: "disabled", packageEnabled: false, packageInstalled: true });
+  } catch {
+    return response({ error: "Paseo 狀態暫時無法取得；請檢查插件安裝與服務。" }, 503);
+  }
+}
+
+export async function POST(req: Request) {
+  if (!isApiRequestAllowed(req)) return response({ error: "Untrusted API request" }, 403);
+  if (!hasJsonContentType(req)) return response({ error: "Content-Type must be application/json" }, 415);
+  try {
+    const body = await readJsonObject(req, MAX_BODY_BYTES);
+    if (typeof body.action !== "string" || !["status", "activate", "disable", "diagnose", "pair", "config", "models"].includes(body.action)) return response({ error: "Unsupported action" }, 400);
+    if (!validCwd(body.cwd)) return response({ error: "Invalid working directory" }, 400);
