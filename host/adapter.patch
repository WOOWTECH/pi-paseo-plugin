+test("Paseo read-only POSTs do not block Stop or wait for package writes", async (t) => {
+  const f = fixture(t);
+  for (const action of ["status", "models", "diagnose"]) {
+    const method = action === "models" ? "listModels" : action === "diagnose" ? "diagnostics" : "status";
+    const original = f.api[method];
+    let releaseRead;
+    let enteredRead;
+    const entered = new Promise((resolve) => { enteredRead = resolve; });
+    f.api[method] = async () => { enteredRead(); await new Promise((resolve) => { releaseRead = resolve; }); return original(); };
+    const read = f.dispatch(f.request({ action, provider: "codex" }));
+    await entered;
+    const stop = f.dispatch(f.request({ action: "disable" }));
+    try {
+      await setImmediate();
+      assert.ok(f.calls.includes("disable"), `A pending ${action} must not prevent Stop`);
+    } finally { releaseRead(); await Promise.all([read, stop]); f.api[method] = original; }
+    f.calls.length = 0;
+  }
+  let releaseWrite;
+  let enteredWrite;
+  const entered = new Promise((resolve) => { enteredWrite = resolve; });
+  const write = f.serialize(async () => { enteredWrite(); await new Promise((resolve) => { releaseWrite = resolve; }); });
+  await entered;
+  const read = f.dispatch(f.request({ action: "status" }));
+  try {
+    await setImmediate();
+    assert.ok(f.calls.includes("status"), "Public status remains accessible during package writes");
+  } finally { releaseWrite(); await Promise.all([write, read]); }
+});
+
+test("Paseo mutations still serialize and retain installed/enabled package metadata", async (t) => {
+  const f = fixture(t);
+  let release;
+  let entered;
+  const started = new Promise((resolve) => { entered = resolve; });
+  f.api.saveConfig = async () => { f.calls.push("config"); entered(); await new Promise((resolve) => { release = resolve; }); };
+  const config = f.dispatch(f.request({ action: "config", config: { name: "Fixture" } }));
+  await started;
+  const stop = f.dispatch(f.request({ action: "disable" }));
+  await setImmediate();
+  assert.equal(f.calls.includes("disable"), false);
+  release();
+  const [res, stopped] = await Promise.all([config, stop]);
+  assert.equal(stopped.status, 200);
+  const status = await res.json();
+  assert.equal(status.packageInstalled, true);
+  assert.equal(status.packageEnabled, true);
+});
+
