+
+test("Paseo rejects malformed inputs before discovering packages or invoking runtime", async (t) => {
+  const f = fixture(t);
+  const cases = [
+    [f.request({ action: "status" }, { headers: { "content-type": "text/plain" } }), 415],
+    [f.request({}, { raw: "{" }), 400],
+    [f.request({}, { raw: "[]" }), 400],
+    [f.request({ action: ["disable"] }), 400],
+    [f.request({ action: "status", cwd: 42 }), 400],
+    [f.request({ action: "status", cwd: "relative" }), 400],
+    [f.request({ action: "models", provider: ["codex"] }), 400],
+    [f.request({ action: "config", config: { name: "x\ncommand" } }), 400],
+  ];
+  for (const [req, status] of cases) assert.equal((await f.dispatch(req)).status, status);
+  assert.deepEqual(f.calls, []);
+});
+
+test("Paseo byte limit rejects multibyte JSON and cancels an oversized streaming body", async (t) => {
+  const f = fixture(t);
+  const raw = JSON.stringify({ action: "status", padding: "界".repeat(6000) });
+  assert.ok(raw.length < 16 * 1024 && Buffer.byteLength(raw) > 16 * 1024);
+  assert.equal((await f.dispatch(f.request({}, { raw }))).status, 413);
+  let cancelled = false;
+  const stream = new ReadableStream({
+    start(controller) { controller.enqueue(new Uint8Array(16 * 1024 + 1)); },
+    cancel() { cancelled = true; },
+  });
+  const pending = f.dispatch(f.request({}, { stream }));
+  // The request deliberately never ends: bounding req.text() after the read
+  // cannot protect this boundary. No timing guess is needed to check cancel.
+  await setImmediate();
+  assert.equal(cancelled, true, "The route cancels at the byte boundary without waiting for EOF");
+  assert.equal((await pending).status, 413);
+  assert.deepEqual(f.calls, []);
+});
+
+test("Paseo authorizes a real directory rather than a file or escaping link", async (t) => {
+  const f = fixture(t);
+  const file = path.join(f.cwd, "file.txt");
+  fs.writeFileSync(file, "fixture");
+  const outside = path.join(f.root, "outside");
+  fs.mkdirSync(outside);
+  const link = path.join(f.cwd, "escape");
+  fs.symlinkSync(outside, link, "dir");
+  for (const cwd of [file, outside, link]) {
+    assert.equal((await f.dispatch(f.request({ action: "activate", cwd }))).status, 404);
+  }
+  assert.deepEqual(f.calls, []);
+});
