index 0000000..c2d002b
--- /dev/null
+++ b/lib/paseo-plugin-lifecycle.ts
@@ -0,0 +1,85 @@
+/** A confirmed Pi package operation, after its settings write succeeded. */
+export type PaseoLifecycleAction = "install" | "enable" | "update" | "disable" | "remove";
+export const PASEO_PACKAGE_NAME = "@woowtech/pi-paseo";
+
+export type PaseoPackageRef = {
+  source: string;
+  scope: "global" | "project";
+  packageName?: string;
+  installedPath?: string;
+  disabled: boolean;
+};
+
+export type PaseoLifecycleResult = {
+  scheduled?: boolean;
+  phase?: string;
+  error?: string;
+};
+
+export type PaseoHostApi = {
+  lifecycle: (input: {
+    action: PaseoLifecycleAction;
+    cwd: string;
+    source: string;
+    scope: "global" | "project";
+    packages: PaseoPackageRef[];
+  }) => Promise<PaseoLifecycleResult>;
+  restore: () => Promise<PaseoLifecycleResult>;
+  status: () => Promise<Record<string, unknown>>;
+  diagnostics: () => Promise<Record<string, unknown>>;
+  pair: () => Promise<{ url: string; expiresAt?: string }>;
+  web?: (request: Request) => Response | Promise<Response>;
+  listModels?: (provider: string) => Promise<Record<string, unknown>>;
+  saveConfig: (input: Record<string, unknown>) => Promise<Record<string, unknown>>;
+};
+
+function key(pkg: Pick<PaseoPackageRef, "source" | "scope">): string {
+  return `${pkg.scope}\0${pkg.source}`;
+}
+
+/** Only successfully changed, named Paseo packages receive lifecycle events. */
+export function paseoLifecycleTargets(
+  action: PaseoLifecycleAction,
+  before: readonly PaseoPackageRef[],
+  after: readonly PaseoPackageRef[],
+  successful: readonly Pick<PaseoPackageRef, "source" | "scope">[],
+): PaseoPackageRef[] {
+  const approved = new Set(successful.map(key));
+  const candidates = action === "remove" ? before : after;
+  return candidates.filter((pkg) => {
+    if (pkg.packageName !== PASEO_PACKAGE_NAME || !approved.has(key(pkg))) return false;
+    const previous = before.find((entry) => key(entry) === key(pkg));
+    if (action === "enable") return !pkg.disabled && Boolean(previous?.disabled);
+    if (action === "disable") return pkg.disabled && previous?.disabled === false;
+    if (action === "install" || action === "update") return !pkg.disabled;
+    return !after.some((entry) => key(entry) === key(pkg));
+  });
+}
+
+/** A lifecycle failure must never turn a successful package install into a retry. */
+export async function dispatchPaseoLifecycle(
+  api: PaseoHostApi,
+  action: PaseoLifecycleAction,
+  cwd: string,
+  target: PaseoPackageRef,
+  packages: PaseoPackageRef[],
+): Promise<PaseoLifecycleResult> {
+  try {
+    const result = await api.lifecycle({ action, cwd, source: target.source, scope: target.scope, packages });
+    return paseoLifecycleResult(result);
+  } catch {
+    // Runtime exceptions may contain subprocess output or a pairing secret.
+    return { error: "Paseo 初始化尚未完成；請開啟設定頁重試或檢查診斷。" };
+  }
+}
+
+/** Lifecycle receipts must not carry arbitrary runtime output into plugin UI. */
+export function paseoLifecycleResult(input: unknown): PaseoLifecycleResult {
+  if (!input || typeof input !== "object") return {};
+  const value = input as Record<string, unknown>;
+  const result: PaseoLifecycleResult = {};
+  if (typeof value.scheduled === "boolean") result.scheduled = value.scheduled;
+  if (typeof value.phase === "string" && /^[a-zA-Z0-9_-]{1,60}$/.test(value.phase)) result.phase = value.phase;
+  if (value.error) result.error = "Paseo 初始化尚未完成；請開啟設定頁檢查診斷。";
+  return result;
+}
