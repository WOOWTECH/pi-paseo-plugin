+import assert from "node:assert/strict";
+import test from "node:test";
+import { paseoDiagnosticChecks, paseoPublicStatus, paseoSessionUrl, readPaseoConfig, safePaseoPairUrl } from "./paseo-ui.ts";
+
+test("pairing opens only the official app and stays out of public status", () => {
+  assert.equal(safePaseoPairUrl("https://app.paseo.sh/pair#secret"), "https://app.paseo.sh/pair#secret");
+  for (const url of ["javascript:alert(1)", "https://app.paseo.sh.evil.example/pair", "https://user:secret@app.paseo.sh", "http://app.paseo.sh", "https://app.paseo.sh:444"]) assert.equal(safePaseoPairUrl(url), null);
+  assert.deepEqual(paseoPublicStatus({ phase: "ready", pairUrl: "secret", url: "secret", providers: [{ id: "codex", available: true, apiKey: "secret", status: "https://secret" }] }), { phase: "ready", providers: [{ id: "codex", available: true }] });
+});
+
+test("configuration accepts only the official-relay display name", () => {
+  assert.deepEqual(readPaseoConfig({ name: " Pi container " }), { name: "Pi container" });
+  for (const config of [null, [], { password: "secret" }, { relayUrl: "https://untrusted" }, { name: "" }, { name: "a\ncommand" }, { cwd: "/workspace" }]) assert.equal(readPaseoConfig(config), null);
+});
+
+test("diagnosis reports actual chat validation separately from installed launchers", () => {
+  const result = paseoDiagnosticChecks({ daemon: { reachable: true }, state: { secret: "secret" }, providers: [{ provider: "claude", launcher: { startup: "ready", command: "secret" } }, { provider: "codex", authentication: "chat_verified" }] });
+  assert.match(result[1].status, /尚未完成對話驗證/);
+  assert.match(result[2].status, /驗證通過/);
+  assert.doesNotMatch(JSON.stringify(result), /secret/);
+});
+
+test("onboarding navigation accepts a session identifier rather than an arbitrary destination", () => {
+  assert.equal(paseoSessionUrl("1234-session"), "/?session=1234-session");
+  assert.equal(paseoSessionUrl("//evil.example"), null);
+  assert.equal(paseoSessionUrl("id&cwd=/other"), null);
+});
diff --git a/lib/paseo-ui.ts b/lib/paseo-ui.ts
new file mode 100644
index 0000000..093267d
--- /dev/null
+++ b/lib/paseo-ui.ts
@@ -0,0 +1,126 @@
+/** Only the official hosted app is opened by this integration. */
+export const PASEO_APP_URL = "https://app.paseo.sh";
+export const PASEO_PROVIDERS = [{ id: "claude", label: "Claude Code" }, { id: "codex", label: "Codex" }, { id: "pi", label: "Pi" }] as const;
+
+export function safePaseoPairUrl(value: unknown): string | null {
+  if (typeof value !== "string" || value.length > 16384) return null;
+  try {
+    const url = new URL(value);
+    return url.protocol === "https:" && url.hostname === "app.paseo.sh" && !url.username && !url.password && !url.port ? url.href : null;
+  } catch { return null; }
+}
+
+export function paseoSessionUrl(id: unknown): string | null {
+  return typeof id === "string" && /^[a-zA-Z0-9_-]{1,100}$/.test(id) ? `/?session=${encodeURIComponent(id)}` : null;
+}
+
+function record(value: unknown): Record<string, unknown> {
+  return value && typeof value === "object" && !Array.isArray(value) ? value as Record<string, unknown> : {};
+}
+function text(value: unknown, max = 150): string | undefined {
+  return typeof value === "string" && value.length > 0 && value.length <= max && !/[\u0000-\u001f\u007f]/.test(value) ? value : undefined;
+}
+function timestamp(value: unknown): string | undefined {
+  return typeof value === "string" && /^\d{4}-\d{2}-\d{2}T[\d:.]+Z$/.test(value) && Number.isFinite(Date.parse(value)) ? value : undefined;
+}
+function choices(value: unknown): Array<{ id: string; label: string; isDefault?: boolean }> {
+  return Array.isArray(value) ? value.slice(0, 200).flatMap((entry) => {
+    const row = record(entry), id = text(row.id), label = text(row.label);
+    return id ? [{ id, label: label ?? id, ...(row.isDefault === true ? { isDefault: true } : {}) }] : [];
+  }) : [];
+}
+
+export type PaseoProviderStatus = {
+  id: string; available?: boolean; authenticated?: boolean; chatVerified?: boolean; status?: string;
+  authentication?: string; chatErrorCode?: string; modes?: Array<{ id: string; label: string }>; defaultModeId?: string;
+};
+export type PaseoPublicStatus = {
+  phase?: string; enabled?: boolean; packageEnabled?: boolean; packageInstalled?: boolean; onboardingSessionId?: string; onboardingCompleted?: boolean; chatVerified?: boolean;
+  daemon?: { running?: boolean; healthy?: boolean; installed?: boolean; relayEnabled?: boolean; relayConnected?: boolean; relayVerified?: boolean; relayVerifiedAt?: string };
+  providers?: PaseoProviderStatus[];
+  configuration?: { name?: string };
+};
+
+/** Only named public fields cross the UI boundary; state and pairing never do. */
+export function paseoPublicStatus(input: unknown): PaseoPublicStatus {
+  const value = record(input), result: PaseoPublicStatus = {};
+  if (typeof value.phase === "string" && /^[a-zA-Z0-9_-]{1,60}$/.test(value.phase)) result.phase = value.phase;
+  for (const flag of ["enabled", "packageEnabled", "packageInstalled", "onboardingCompleted", "chatVerified"] as const) if (typeof value[flag] === "boolean") result[flag] = value[flag];
+  if (paseoSessionUrl(value.onboardingSessionId)) result.onboardingSessionId = value.onboardingSessionId as string;
+  if (value.daemon && typeof value.daemon === "object") {
+    const daemon = record(value.daemon);
+    result.daemon = {};
+    for (const flag of ["running", "healthy", "installed", "relayEnabled", "relayConnected", "relayVerified"] as const) if (typeof daemon[flag] === "boolean") result.daemon[flag] = daemon[flag];
+    if (typeof daemon.reachable === "boolean") result.daemon.healthy = daemon.reachable;
+    if (typeof value.installed === "boolean") result.daemon.installed = value.installed;
+    const at = timestamp(daemon.relayVerifiedAt);
+    if (at) result.daemon.relayVerifiedAt = at;
+  }
+  if (Array.isArray(value.providers)) {
+    result.providers = value.providers.flatMap((entry) => {
+      const provider = record(entry), id = provider.id ?? provider.provider;
+      if (typeof id !== "string" || !["claude", "claude-code", "codex", "pi"].includes(id)) return [];
+      const row: PaseoProviderStatus = { id };
+      const acceptance = record(record(value.state).acceptance);
+      const check = Array.isArray(acceptance.providers) ? record(acceptance.providers.find((entry) => record(entry).provider === id)) : {};
+      const code = provider.chatErrorCode ?? check.code;
+      if (check.passed === true) row.chatVerified = true;
+      if (typeof code === "string" && /^[A-Z_]{1,60}$/.test(code)) row.chatErrorCode = code;
+      for (const flag of ["available", "authenticated", "chatVerified"] as const) if (typeof provider[flag] === "boolean") row[flag] = provider[flag];
+      if (row.available === undefined && ["ready", "available", "unavailable", "missing"].includes(String(provider.status))) row.available = ["ready", "available"].includes(String(provider.status));
+      if (typeof provider.status === "string" && /^[a-zA-Z0-9_-]{1,60}$/.test(provider.status)) row.status = provider.status;
+      if (["chat_verified", "login_required", "needs_chat_verification"].includes(String(provider.authentication))) row.authentication = String(provider.authentication);
+      if (provider.authentication === "chat_verified") row.chatVerified = true;
+      if (typeof provider.chatErrorCode === "string" && /^[A-Z_]{1,60}$/.test(provider.chatErrorCode)) row.chatErrorCode = provider.chatErrorCode;
+      if (Array.isArray(provider.modes)) row.modes = choices(provider.modes);
+      const mode = text(provider.defaultModeId);
+      if (mode) row.defaultModeId = mode;
+      return [row];
+    });
+  }
+  const config = record(value.configuration ?? value.settings);
+  const name = text(config.name, 100);
+  if (name) result.configuration = { name };
+  return result;
+}
+
+export function paseoProviderLabel(provider?: PaseoProviderStatus): string {
+  if (provider?.chatVerified) return "兩輪對話驗證通過";
+  if (provider?.chatErrorCode === "PROVIDER_QUOTA_EXHAUSTED" || provider?.chatErrorCode === "PROVIDER_RATE_LIMITED") return "額度／速率限制，尚未完成對話驗證";
+  if (provider?.authentication === "login_required" || provider?.chatErrorCode === "PROVIDER_AUTH_REQUIRED") return "需要官方登入，尚未完成對話驗證";
+  if (provider?.chatErrorCode) return `對話驗證尚未通過（${provider.chatErrorCode}）`;
+  if (provider?.authenticated) return "登入已確認，尚未完成對話驗證";
+  return provider?.available ? "提供者可用，尚未完成對話驗證" : "待診斷確認";
+}
+
+export type PaseoModelCatalog = { provider: string; modes: Array<{ id: string; label: string }>; models: Array<{ id: string; label: string; isDefault?: boolean; thinkingOptions: Array<{ id: string; label: string }> }> };
+export function paseoModelCatalog(input: unknown, provider: string): PaseoModelCatalog {
+  const value = record(input);
+  return { provider, modes: choices(value.modes), models: Array.isArray(value.models) ? value.models.slice(0, 500).flatMap((entry) => {
+    const row = record(entry), id = text(row.id), label = text(row.label);
+    return id ? [{ id, label: label ?? id, ...(row.isDefault === true ? { isDefault: true } : {}), thinkingOptions: choices(row.thinkingOptions) }] : [];
+  }) : [] };
+}
+
+export function readPaseoConfig(input: unknown): Record<string, string> | null {
+  if (!input || typeof input !== "object" || Array.isArray(input)) return null;
+  const config = input as Record<string, unknown>;
+  if (Object.keys(config).some((key) => key !== "name")) return null;
+  if (config.name === undefined) return {};
+  if (typeof config.name !== "string") return null;
+  const name = config.name.trim();
+  return text(name, 100) ? { name } : null;
+}
+
+/** Diagnostics summarize evidence and limitations without subprocess output. */
+export function paseoDiagnosticChecks(input: unknown): Array<{ name: string; status: string }> {
+  const value = record(input), daemon = record(value.daemon);
+  const providers = paseoPublicStatus(value).providers;
+  const checks = [{ name: "Paseo 服務", status: daemon.reachable === true ? "連線正常" : "尚未連線" }];
+  for (const { id, label } of PASEO_PROVIDERS) {
+    const raw = Array.isArray(value.providers) ? value.providers.find((entry) => record(entry).provider === id || record(entry).id === id) : undefined;
+    const provider = providers?.find((entry) => entry.id === id);
+    checks.push({ name: label, status: paseoProviderLabel({ ...provider, id, available: provider?.available ?? (record(record(raw).launcher).startup === "ready") }) });
+  }
+  return checks;
+}
