+import assert from "node:assert/strict";
+import test from "node:test";
+import { paseoDiagnosticChecks, paseoPublicStatus, readPaseoConfig, safePaseoPairUrl } from "./paseo-ui.ts";
+
+test("pairing opens only the official app and stays out of public status", () => {
+  assert.equal(safePaseoPairUrl("https://app.paseo.sh/#offer=abc_DEF-123"), "https://app.paseo.sh/#offer=abc_DEF-123");
+  // The bundled /paseo-web client is retired; its links and any other entry are refused.
+  for (const url of ["/paseo-web/welcome#offer=x", "//evil.example/#offer=x", "https://app.paseo.sh/pair#offer=x", "https://app.paseo.sh/welcome#offer=x", "https://app.paseo.sh/#secret", "https://app.paseo.sh/#offer=x&next=evil", "https://app.paseo.sh/#offer=", "https://app.paseo.sh/?redirect=evil#offer=x", "https://app.paseo.sh/#offer=bad\nvalue", "https://app.paseo.sh/#offer=bad\\value"]) assert.equal(safePaseoPairUrl(url), null, url);
+  for (const url of ["javascript:alert(1)", "https://app.paseo.sh.evil.example/#offer=x", "https://user:secret@app.paseo.sh/#offer=x", "http://app.paseo.sh/#offer=x", "https://app.paseo.sh:444/#offer=x"]) assert.equal(safePaseoPairUrl(url), null, url);
+  assert.deepEqual(paseoPublicStatus({ phase: "ready", privateTimestamp: { readAt: 1234, value: "secret" }, statusReadAt: 1234, pairUrl: "secret", url: "secret", webClient: { ready: true, version: "0.13.0-woow.1" }, providers: [{ id: "codex", available: true, apiKey: "secret", status: "https://secret" }] }), { phase: "ready", providers: [{ id: "codex", available: true }] });
+});
+
+test("configuration accepts only the official-relay display name", () => {
+  assert.deepEqual(readPaseoConfig({ name: " Pi container " }), { name: "Pi container" });
+  assert.deepEqual(readPaseoConfig({ name: " " }), { name: "" });
+  for (const config of [null, [], { password: "secret" }, { relayUrl: "https://untrusted" }, { name: "a\ncommand" }, { cwd: "/workspace" }]) assert.equal(readPaseoConfig(config), null);
+});
+
+test("diagnosis reports actual chat validation separately from installed launchers", () => {
+  const result = paseoDiagnosticChecks({ daemon: { reachable: true }, state: { secret: "secret" }, providers: [{ provider: "claude", launcher: { startup: "ready", command: "secret" } }, { provider: "codex", authentication: "chat_verified" }] });
+  assert.match(result[1].status, /尚未完成對話驗證/);
+  assert.match(result[2].status, /驗證通過/);
+  assert.doesNotMatch(JSON.stringify(result), /secret/);
+});
+
+test("public status drops legacy onboarding references", () => {
+  assert.deepEqual(paseoPublicStatus({ onboardingSessionId: "old-session", onboardingCompleted: true }), {});
+});
+
+test("connection settings accept the three targets and reject arbitrary endpoints", () => {
+  for (const target of ["paseo", "woowtech", "apporo"]) {
+    assert.deepEqual(readPaseoConfig({ target }), { target });
+    assert.deepEqual(readPaseoConfig({ name: " Pi ", target }), { name: "Pi", target });
+  }
+  for (const target of [null, "", "other", "__proto__", {}, 1]) assert.equal(readPaseoConfig({ target }), null);
+});
+
+test("pairing is bound to the selected target's official app and exact offer entry", () => {
+  const origins = { woowtech: "https://smart.woowtech.io", apporo: "https://smart.apporo.ai", paseo: "https://app.paseo.sh" };
+  for (const [target, origin] of Object.entries(origins)) {
+    assert.equal(safePaseoPairUrl(`${origin}/#offer=abc_DEF-123`, target), `${origin}/#offer=abc_DEF-123`);
+    const others = Object.entries(origins).filter(([id]) => id !== target).map(([, other]) => `${other}/#offer=x`);
+    for (const url of [`${origin}/pair#offer=x`, `${origin}/?redirect=x#offer=x`, `${origin}/#token=x`, `${origin}/#offer=x&next=evil`, `${origin}/#offer=`, "/paseo-web/welcome#offer=x", ...others])
+      assert.equal(safePaseoPairUrl(url, target), null, url);
+  }
+  assert.equal(safePaseoPairUrl("https://smart.apporo.ai/#offer=x"), null);
+});
+
+test("public target settings preserve only validated fields without pairing or caller URLs", () => {
+  assert.deepEqual(paseoPublicStatus({ settings: { name: "Pi", target: "apporo", url: "secret" }, selectedTarget: "apporo", activeTarget: "paseo", configurationPending: true, openUrl: "https://evil.example", connectionTargets: [{ appUrl: "https://evil.example" }] }), {
+    configuration: { name: "Pi", target: "apporo" }, selectedTarget: "apporo", activeTarget: "paseo", configurationPending: true,
+  });
+  assert.deepEqual(paseoPublicStatus({ settings: { target: "evil" }, selectedTarget: "evil", activeTarget: "evil", configurationPending: "yes" }), {});
+});
+
+test("agent collaboration is an explicit boolean in settings and public status", () => {
+  assert.deepEqual(readPaseoConfig({ agentCollaboration: true }), { agentCollaboration: true });
+  assert.deepEqual(readPaseoConfig({ name: " Pi ", target: "woowtech", agentCollaboration: false }), { name: "Pi", target: "woowtech", agentCollaboration: false });
+  for (const value of ["true", 1, 0, null, {}, []]) assert.equal(readPaseoConfig({ agentCollaboration: value }), null, JSON.stringify(value));
+  assert.deepEqual(paseoPublicStatus({ settings: { target: "paseo", agentCollaboration: true } }).configuration, { target: "paseo", agentCollaboration: true });
+  assert.deepEqual(paseoPublicStatus({ settings: { target: "paseo", agentCollaboration: false } }).configuration, { target: "paseo", agentCollaboration: false });
+  for (const value of ["yes", 1, null]) assert.deepEqual(paseoPublicStatus({ settings: { target: "paseo", agentCollaboration: value } }).configuration, { target: "paseo" });
+});
diff --git a/lib/paseo-ui.ts b/lib/paseo-ui.ts
new file mode 100644
index 0000000..1054969
--- /dev/null
+++ b/lib/paseo-ui.ts
@@ -0,0 +1,166 @@
+export const PASEO_PROVIDERS = [{ id: "claude", label: "Claude Code" }, { id: "codex", label: "Codex" }, { id: "pi", label: "Pi" }] as const;
+
+/** Fixed official apps; no caller-provided origins receive pairing material. */
+export const CONNECTION_TARGETS = [
+  { id: "woowtech", label: "Woowtech Smart", appUrl: "https://smart.woowtech.io/" },
+  { id: "apporo", label: "Apporo Smart", appUrl: "https://smart.apporo.ai/" },
+  { id: "paseo", label: "Paseo", appUrl: "https://app.paseo.sh/" },
+] as const;
+export type ConnectionTarget = typeof CONNECTION_TARGETS[number]["id"];
+export function isConnectionTarget(value: unknown): value is ConnectionTarget {
+  return CONNECTION_TARGETS.some((target) => target.id === value);
+}
+export function connectionTarget(value: unknown) {
+  return CONNECTION_TARGETS.find((target) => target.id === value) ?? CONNECTION_TARGETS[2];
+}
+export function safePaseoPairUrl(value: unknown, target: unknown = "paseo"): string | null {
+  if (!isConnectionTarget(target) || typeof value !== "string" || value.length > 16384 || /[\s\\]/.test(value)) return null;
+  try {
+    const url = new URL(value);
+    if (url.origin !== new URL(connectionTarget(target).appUrl).origin || url.username || url.password || url.search) return null;
+    return url.pathname === "/" && /^#offer=[A-Za-z0-9_-]+$/.test(url.hash) ? url.href : null;
+  } catch { return null; }
+}
+
+function record(value: unknown): Record<string, unknown> {
+  return value && typeof value === "object" && !Array.isArray(value) ? value as Record<string, unknown> : {};
+}
+function text(value: unknown, max = 150): string | undefined {
+  return typeof value === "string" && value.length > 0 && value.length <= max && !/[\u0000-\u001f\u007f]/.test(value) ? value : undefined;
+}
+function timestamp(value: unknown): string | undefined {
+  return typeof value === "string" && /^\d{4}-\d{2}-\d{2}T[\d:.]+Z$/.test(value) && Number.isFinite(Date.parse(value)) ? value : undefined;
+}
+function choices(value: unknown): Array<{ id: string; label: string; isDefault?: boolean }> {
+  return Array.isArray(value) ? value.slice(0, 200).flatMap((entry) => {
+    const row = record(entry), id = text(row.id), label = text(row.label);
+    return id ? [{ id, label: label ?? id, ...(row.isDefault === true ? { isDefault: true } : {}) }] : [];
+  }) : [];
+}
+
+export type PaseoProviderStatus = {
+  id: string; available?: boolean; authenticated?: boolean; chatVerified?: boolean; status?: string;
+  authentication?: string; chatErrorCode?: string; chatCheckedAt?: string; modes?: Array<{ id: string; label: string }>; defaultModeId?: string;
+};
+export type PaseoPublicStatus = {
+  phase?: string; enabled?: boolean; packageEnabled?: boolean; packageInstalled?: boolean; chatVerified?: boolean;
+  chatCheckedAt?: string;
+  daemon?: { running?: boolean; healthy?: boolean; installed?: boolean; relayEnabled?: boolean; relayConnected?: boolean; relayVerified?: boolean; relayVerifiedAt?: string };
+  providers?: PaseoProviderStatus[];
+  configuration?: { name?: string; target?: ConnectionTarget; agentCollaboration?: boolean };
+  selectedTarget?: ConnectionTarget; activeTarget?: ConnectionTarget; configurationPending?: boolean;
+};
+
+/** Only named public fields cross the UI boundary; state and pairing never do. */
+export function paseoPublicStatus(input: unknown): PaseoPublicStatus {
+  const value = record(input), result: PaseoPublicStatus = {};
+  const acceptance = record(record(value.state).acceptance);
+  const checkedAt = timestamp(value.chatCheckedAt ?? acceptance.checkedAt);
+  if (checkedAt) result.chatCheckedAt = checkedAt;
+  if (typeof value.phase === "string" && /^[a-zA-Z0-9_-]{1,60}$/.test(value.phase)) result.phase = value.phase;
+  for (const flag of ["enabled", "packageEnabled", "packageInstalled", "chatVerified"] as const) if (typeof value[flag] === "boolean") result[flag] = value[flag];
+  if (value.daemon && typeof value.daemon === "object") {
+    const daemon = record(value.daemon);
+    result.daemon = {};
+    for (const flag of ["running", "healthy", "installed", "relayEnabled", "relayConnected", "relayVerified"] as const) if (typeof daemon[flag] === "boolean") result.daemon[flag] = daemon[flag];
+    if (typeof daemon.reachable === "boolean") result.daemon.healthy = daemon.reachable;
+    if (typeof value.installed === "boolean") result.daemon.installed = value.installed;
+    const at = timestamp(daemon.relayVerifiedAt);
+    if (at) result.daemon.relayVerifiedAt = at;
+  }
+  if (Array.isArray(value.providers)) {
+    result.providers = value.providers.slice(0, 20).flatMap((entry) => {
+      const provider = record(entry), id = provider.id ?? provider.provider;
+      if (typeof id !== "string" || !["claude", "claude-code", "codex", "pi"].includes(id)) return [];
+      const row: PaseoProviderStatus = { id };
+      const canonicalId = id === "claude-code" ? "claude" : id;
+      const check = Array.isArray(acceptance.providers) ? record(acceptance.providers.find((entry) => record(entry).provider === canonicalId)) : {};
+      const at = timestamp(provider.chatCheckedAt ?? provider.checkedAt ?? check.checkedAt);
+      if (at) row.chatCheckedAt = at;
+      const code = provider.chatErrorCode ?? check.code;
+      if (check.passed === true) row.chatVerified = true;
+      if (typeof code === "string" && /^[A-Z_]{1,60}$/.test(code)) row.chatErrorCode = code;
+      for (const flag of ["available", "authenticated", "chatVerified"] as const) if (typeof provider[flag] === "boolean") row[flag] = provider[flag];
+      if (row.available === undefined && ["ready", "available", "unavailable", "missing"].includes(String(provider.status))) row.available = ["ready", "available"].includes(String(provider.status));
+      if (typeof provider.status === "string" && /^[a-zA-Z0-9_-]{1,60}$/.test(provider.status)) row.status = provider.status;
+      if (["chat_verified", "login_required", "needs_chat_verification"].includes(String(provider.authentication))) row.authentication = String(provider.authentication);
+      if (provider.authentication === "chat_verified") row.chatVerified = true;
+      if (typeof provider.chatErrorCode === "string" && /^[A-Z_]{1,60}$/.test(provider.chatErrorCode)) row.chatErrorCode = provider.chatErrorCode;
+      if (Array.isArray(provider.modes)) row.modes = choices(provider.modes);
+      const mode = text(provider.defaultModeId);
+      if (mode) row.defaultModeId = mode;
+      return [row];
+    });
+  }
+  const config = record(value.configuration ?? value.settings);
+  const name = text(config.name, 100);
+  if (name) result.configuration = { name };
+  if (isConnectionTarget(config.target)) result.configuration = { ...result.configuration, target: config.target };
+  if (typeof config.agentCollaboration === "boolean") result.configuration = { ...result.configuration, agentCollaboration: config.agentCollaboration };
+  if (isConnectionTarget(value.selectedTarget)) result.selectedTarget = value.selectedTarget;
+  if (isConnectionTarget(value.activeTarget)) result.activeTarget = value.activeTarget;
+  if (typeof value.configurationPending === "boolean") result.configurationPending = value.configurationPending;
+  return result;
+}
+
+export function paseoProviderLabel(provider?: PaseoProviderStatus): string {
+  if (provider?.chatErrorCode === "PROVIDER_QUOTA_EXHAUSTED" || provider?.chatErrorCode === "PROVIDER_RATE_LIMITED") return "額度／速率限制，尚未完成對話驗證";
+  if (provider?.authentication === "login_required" || provider?.chatErrorCode === "PROVIDER_AUTH_REQUIRED") return "需要官方登入，尚未完成對話驗證";
+  if (provider?.chatErrorCode) return `對話驗證尚未通過（${provider.chatErrorCode}）`;
+  if (provider?.chatVerified) return `兩輪對話驗證通過（歷史紀錄${provider.chatCheckedAt ? `：${provider.chatCheckedAt}` : ""}）；目前登入與額度需重新確認`;
+  if (provider?.authenticated) return "登入已確認，尚未完成對話驗證";
+  return provider?.available ? "提供者可用，尚未完成對話驗證" : "待診斷確認";
+}
+
+export type PaseoModelCatalog = { provider: string; modes: Array<{ id: string; label: string }>; models: Array<{ id: string; label: string; isDefault?: boolean; thinkingOptions: Array<{ id: string; label: string }> }> };
+export function paseoModelCatalog(input: unknown, provider: string): PaseoModelCatalog {
+  const value = record(input);
+  return { provider, modes: choices(value.modes), models: Array.isArray(value.models) ? value.models.slice(0, 500).flatMap((entry) => {
+    const row = record(entry), id = text(row.id), label = text(row.label);
+    return id ? [{ id, label: label ?? id, ...(row.isDefault === true ? { isDefault: true } : {}), thinkingOptions: choices(row.thinkingOptions) }] : [];
+  }) : [] };
+}
+
+export type PaseoConfigInput = { name?: string; target?: ConnectionTarget; agentCollaboration?: boolean };
+/** How a saved agent-collaboration change reached the daemon, as the runtime reports it. */
+export const AGENT_COLLABORATION_RESULTS = ["applied", "unchanged", "next-start", "restart-required"] as const;
+export type AgentCollaborationResult = typeof AGENT_COLLABORATION_RESULTS[number];
+export function agentCollaborationResult(value: unknown): AgentCollaborationResult | undefined {
+  return (AGENT_COLLABORATION_RESULTS as readonly unknown[]).includes(value) ? value as AgentCollaborationResult : undefined;
+}
+
+export function readPaseoConfig(input: unknown): PaseoConfigInput | null {
+  if (!input || typeof input !== "object" || Array.isArray(input)) return null;
+  const config = input as Record<string, unknown>;
+  if (Object.keys(config).some((key) => !["name", "target", "agentCollaboration"].includes(key))) return null;
+  const result: PaseoConfigInput = {};
+  if (config.target !== undefined) {
+    if (!isConnectionTarget(config.target)) return null;
+    result.target = config.target;
+  }
+  if (config.name !== undefined) {
+    if (typeof config.name !== "string") return null;
+    const name = config.name.trim();
+    if (name && !text(name, 100)) return null;
+    result.name = name;
+  }
+  if (config.agentCollaboration !== undefined) {
+    // Only an explicit boolean opts agents into Paseo's agent-management tools.
+    if (typeof config.agentCollaboration !== "boolean") return null;
+    result.agentCollaboration = config.agentCollaboration;
+  }
+  return result;
+}
+
+/** Diagnostics summarize evidence and limitations without subprocess output. */
+export function paseoDiagnosticChecks(input: unknown): Array<{ name: string; status: string }> {
+  const value = record(input), daemon = record(value.daemon);
+  const providers = paseoPublicStatus(value).providers;
+  const checks = [{ name: "Agent Connect 服務", status: daemon.reachable === true ? "連線正常" : "尚未連線" }];
+  for (const { id, label } of PASEO_PROVIDERS) {
+    const raw = Array.isArray(value.providers) ? value.providers.find((entry) => record(entry).provider === id || record(entry).id === id) : undefined;
+    const provider = providers?.find((entry) => entry.id === id);
+    checks.push({ name: label, status: paseoProviderLabel({ ...provider, id, available: provider?.available ?? (record(record(raw).launcher).startup === "ready") }) });
+  }
+  return checks;
+}
diff --git a/lib/plugin-lifecycle.ts b/lib/plugin-lifecycle.ts
new file mode 100644
index 0000000..250a60b
--- /dev/null
+++ b/lib/plugin-lifecycle.ts
@@ -0,0 +1,71 @@
+import { existsSync } from "node:fs";
+import { homedir } from "node:os";
+import { join, resolve } from "node:path";
+import { applyPaseoPackageLifecycle, loadPaseoHostApi, restorePaseoPlugin } from "./paseo-plugin";
+import { PASEO_PACKAGE_NAME, type PaseoHostApi, type PaseoLifecycleAction, type PaseoPackageRef } from "./paseo-plugin-lifecycle";
+import { readRegularFileText } from "./regular-file";
+
+/** Generic package route seam; integration discovery stays outside the route. */
+export async function notifyPluginPackageChange(
+  action: PaseoLifecycleAction, cwd: string, before: PaseoPackageRef[], after: PaseoPackageRef[],
+  successful: Pick<PaseoPackageRef, "source" | "scope">[], preloaded?: PaseoHostApi,
+) {
+  const paseo = await applyPaseoPackageLifecycle(action, cwd, before, after, successful, preloaded);
+  return paseo ? { paseo } : {};
+}
+
+/** The registration is service intent; runtime desiredEnabled can lag behind it. */
+function priorServiceEnabled(runtimeEnabled: boolean): boolean {
+  // Match the plugin's locations() without reading state, pairing or account files.
+  const home = resolve(process.env.HOME || homedir());
+  const agentDir = resolve(process.env.PI_CODING_AGENT_DIR || process.env.PI_AGENT_DATA_DIR || (existsSync("/data/pi-agent") ? "/data/pi-agent" : join(home, ".pi/agent")));
+  const stateDir = resolve(process.env.PI_PASEO_STATE_DIR || join(agentDir, "pi-paseo"));
+  const raw = readRegularFileText(join(stateDir, "host-registration.json"), 64 * 1024);
+  if (raw === undefined) return runtimeEnabled;
+  const registration = JSON.parse(raw) as Record<string, unknown>;
+  if (!registration || typeof registration !== "object" || Array.isArray(registration) || (registration.enabled !== undefined && typeof registration.enabled !== "boolean")) {
+    throw new Error("Paseo registration unavailable");
+  }
+  return typeof registration.enabled === "boolean" ? registration.enabled : runtimeEnabled;
+}
+
+/** Stop the last binding, or migrate supervision before deleting its modules. */
+export async function preparePluginPackageRemoval(cwd: string, packages: PaseoPackageRef[], source: string, scope: "global" | "project") {
+  const target = packages.find((pkg) => pkg.packageName === PASEO_PACKAGE_NAME && pkg.source === source && pkg.scope === scope);
+  if (!target) return undefined;
+  const api = await loadPaseoHostApi(target, true);
+  const paseoPackages = packages.filter((pkg) => pkg.packageName === PASEO_PACKAGE_NAME);
+  const remaining = paseoPackages.find((pkg) => !pkg.disabled && (pkg.source !== source || pkg.scope !== scope));
+  let wasEnabled = false;
+  let recovery = api;
+  try {
+    wasEnabled = priorServiceEnabled((await api.status()).enabled === true);
+    if (remaining) {
+      recovery = await loadPaseoHostApi(remaining);
+      // restore honors a manual pause; when enabled, startSupervisor waits for
+      // the old package's supervisor to exit before starting the remaining one.
+      await recovery.restore();
+    } else {
+      await api.lifecycle({ action: "remove", cwd, source, scope, packages: [] });
+      const status = await api.status();
+      if (status.enabled === true || (status.daemon as { running?: boolean } | undefined)?.running === true) throw new Error("Cleanup incomplete");
+    }
+  } catch {
+    throw new Error("Paseo 服務尚未停止；請先在設定頁停止服務，再移除插件。");
+  }
+  return {
+    api: recovery,
+    async recover() {
+      if (remaining) {
+        await recovery.restore();
+      } else if (wasEnabled && !target.disabled) {
+        // Undo only our temporary cleanup pause, never a pre-existing Stop.
+        await recovery.lifecycle({ action: "enable", cwd, source, scope, packages: paseoPackages });
+      }
+    },
+  };
+}
+
+export function restorePluginPackages(): Promise<void> {
+  return restorePaseoPlugin();
+}
