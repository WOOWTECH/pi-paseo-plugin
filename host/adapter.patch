+++ b/e2e/paseo-mobile-scroll.mjs
@@ -0,0 +1,105 @@
+import assert from 'node:assert/strict';
+import {chromium} from 'playwright';
+
+// Existing Pi Web build, real components/styles/touch events. Mock only Paseo
+// data to reproduce long content without credentials or runtime mutations.
+const base = process.env.PI_WEB_E2E_URL || 'http://127.0.0.1:30141';
+const browser = await chromium.launch({
+  ...(process.env.PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH ? {executablePath:process.env.PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH} : {}),
+});
+const status = {
+  enabled:true,packageEnabled:true,packageInstalled:true,phase:'running',
+  daemon:{healthy:true,running:true,installed:true},
+  providers:['claude','codex','pi'].map(id=>({id,chatVerified:true})),
+};
+const viewports = [
+  {name:'phone',width:390,height:780,mobile:true},
+  {name:'small-phone',width:360,height:640,mobile:true},
+  {name:'landscape',width:844,height:390,mobile:true},
+  {name:'desktop',width:1280,height:900,mobile:false},
+];
+const cases = viewports;
+const results = [];
+try {
+  for (const c of cases) {
+    const context = await browser.newContext({viewport:{width:c.width,height:c.height},isMobile:c.mobile,hasTouch:c.mobile,locale:'en-US'});
+    try {
+      const page = await context.newPage();
+      const errors=[];page.on('pageerror',e=>errors.push(e.name));
+      await page.route('**/api/plugin-paseo*', async route => {
+        const request=route.request();
+        const body=request.method()==='POST' ? request.postDataJSON() : {};
+        assert.ok(!body.action || body.action==='models', 'Layout test must not mutate runtime');
+        await route.fulfill({json:body.action==='models' ? {
+          modes:[],models:Array.from({length:60},(_,i)=>({id:`model-${i}`,label:`Scroll model ${i} ${'long-name-'.repeat(8)}`})),
+        } : status});
+      });
+      await page.goto(base+'/',{waitUntil:'domcontentloaded'});
+      await page.waitForTimeout(1200);
+      assert.equal(new URL(page.url()).searchParams.has('session'),false,`${c.name}: home must not open a Paseo setup conversation`);
+      assert.equal(await page.getByRole('button',{name:/Paseo/i}).count(),0,`${c.name}: no Paseo shortcut on home`);
+      assert.equal(await page.getByRole('link',{name:/Paseo/i}).count(),0,`${c.name}: no Paseo link on home`);
+      const target=new URL(c.name==='phone' ? '/paseo/setup' : '/',base);
+      target.searchParams.set('cwd',process.env.HOME);
+      if(c.name!=='phone')target.searchParams.set('settings','plugins');
+      await page.goto(target.href,{waitUntil:'domcontentloaded'});
+      assert.equal(new URL(page.url()).searchParams.get('settings'),'plugins');
+      const panel=page.getByRole('region',{name:'Paseo 連線設定'});
+      await panel.waitFor();
+      const scrollRoot=page.locator('.config-detail').filter({has:panel});
+      const button=panel.getByRole('button',{name:'讀取 Pi 模型',exact:true});
+      await page.waitForFunction(()=>{const b=[...document.querySelectorAll('button')].find(b=>b.textContent==='讀取 Pi 模型');return b&&!b.disabled;});
+      const cdp=await context.newCDPSession(page);
+      async function swipe(direction=1) {
+        const box=await scrollRoot.boundingBox();
+        const x=Math.min(c.width-32,box.x+box.width*0.65);
+        const top=Math.max(90,box.y+30),bottom=Math.min(c.height-110,box.y+box.height-32);
+        if(c.mobile){
+          const start=direction>0?bottom:top,end=direction>0?top:bottom;
+          await cdp.send('Input.dispatchTouchEvent',{type:'touchStart',touchPoints:[{x,y:start}]});
+          for(let i=1;i<=10;i++){
+            await cdp.send('Input.dispatchTouchEvent',{type:'touchMove',touchPoints:[{x,y:start+(end-start)*i/10}]});
+            await page.waitForTimeout(16);
+          }
+          await cdp.send('Input.dispatchTouchEvent',{type:'touchEnd',touchPoints:[]});
+        }else{
+          await page.mouse.move(x,bottom);await page.mouse.wheel(0,direction*600);
+        }
+        await page.waitForTimeout(100);
+      }
+      async function inViewport(locator) {
+        return locator.evaluate(el=>{
+          const r=el.getBoundingClientRect();
+          if(r.top<0||r.bottom>innerHeight||r.left<0||r.right>innerWidth)return false;
+          const hit=document.elementFromPoint(r.x+r.width/2,r.y+r.height/2);
+          return hit===el||el.contains(hit);
+        });
+      }
+      async function reach(locator,direction=1) {
+        for(let i=0;i<45 && !(await inViewport(locator));i++){
+          const target=await locator.boundingBox(), root=await scrollRoot.boundingBox();
+          const toward=target&&root ? target.y<root.y+12 ? -1 : target.y+target.height>root.y+root.height-12 ? 1 : direction : direction;
+          await swipe(toward);
+        }
+        if (!(await inViewport(locator))) {
+          await page.screenshot({ path: '/tmp/pi-paseo-scroll-failure.png' });
+          const metrics = await scrollRoot.evaluate(el => ({scrollTop:el.scrollTop,scrollHeight:el.scrollHeight,clientHeight:el.clientHeight,rect:el.getBoundingClientRect().toJSON(),overflow:getComputedStyle(el).overflowY}));
+          assert.fail(`${c.name}: control reachable by ${c.mobile?'touch':'wheel'} scrolling; ${JSON.stringify(metrics)}`);
+        }
+      }
+      // Never let click/scrollIntoView hide a broken gesture scroll path.
+      await reach(button);
+      await button.click();
+      const last=panel.locator('li').last();
+      await last.waitFor();
+      await reach(last);
+      assert.ok((await last.textContent()).startsWith('Scroll model 59'));
+      assert.equal(await panel.evaluate(el=>el.scrollWidth>el.clientWidth+1),false,`${c.name}: long model names must wrap`);
+      await reach(panel.getByText('Paseo 連線',{exact:true}),-1);
+      assert.deepEqual(errors,[]);
+      results.push({case:c.name,touch:c.mobile,bottomControls:true,expandedCatalog:true,returnToTop:true,pageErrors:0});
+      console.log(JSON.stringify(results.at(-1)));
+    } finally {await context.close();}
+  }
+} finally {await browser.close();}
+assert.equal(results.length,cases.length);
