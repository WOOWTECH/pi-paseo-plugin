index 0000000..69af13e
--- /dev/null
+++ b/app/api/plugin-paseo/route.ts
@@ -0,0 +1,110 @@
+import { NextResponse } from "next/server";
+import { readJsonObject, RequestBodyError } from "@/lib/json-request";
+import { homedir } from "node:os";
+import { statSync } from "node:fs";
+import { isAbsolute } from "node:path";
+import { getAllowedFileRoots, isExistingFilePathAllowed } from "@/lib/file-access";
+import { hasJsonContentType, isApiRequestAllowed } from "@/lib/request-security";
+import { configuredPaseoPackages, loadPaseoHostApi } from "@/lib/paseo-plugin";
+import { paseoLifecycleResult } from "@/lib/paseo-plugin-lifecycle";
+import { serializePluginPackageOperation } from "@/lib/plugin-package-lock";
+import { agentCollaborationResult, isConnectionTarget, paseoDiagnosticChecks, paseoModelCatalog, paseoPublicStatus, readPaseoConfig, safePaseoPairUrl } from "@/lib/paseo-ui";
+
+export const dynamic = "force-dynamic";
+export const runtime = "nodejs";
+const headers = { "Cache-Control": "private, no-store", "Referrer-Policy": "no-referrer" };
+const MAX_BODY_BYTES = 16 * 1024;
+
+function validCwd(cwd: unknown): boolean {
+  return cwd === undefined || (typeof cwd === "string" && cwd.length <= 4096 && !/[\u0000-\u001f\u007f]/.test(cwd) && (cwd === "" || isAbsolute(cwd)));
+}
+
+function response(value: unknown, status = 200) {
+  return NextResponse.json(value, { status, headers });
+}
+
+function directoryExists(directory: string): boolean {
+  try { return statSync(directory).isDirectory(); } catch { return false; }
+}
+
+async function context(cwd: unknown) {
+  // A directory named by the client must be one Pi Web already serves. The server's own fallback (PI_PASEO_CWD, else
+  // the user's home) is trusted: startup recovery already reads it without that check, and requiring it made this
+  // panel unreachable on a fresh install that has no conversation and no selected project (the project picker only
+  // registers a child directory of home).
+  const requested = typeof cwd === "string" && cwd ? cwd : undefined;
+  const configured = process.env.PI_PASEO_CWD;
+  const directory = requested ?? (configured || homedir());
+  if (!validCwd(directory) || !directoryExists(directory)) return null;
+  const served = isExistingFilePathAllowed(directory, await getAllowedFileRoots());
+  if (!served && requested) return null;
+  // Outside the served roots only the global package is read, unless the operator named a project explicitly
+  // with PI_PASEO_CWD.
+  const packages = configuredPaseoPackages(directory, !served && !configured);
+  const target = packages.find((pkg) => !pkg.disabled) ?? packages[0];
+  if (!target) return null;
+  return { cwd: directory, packages, target, api: target.disabled ? null : await loadPaseoHostApi(target) };
+}
+
+export async function GET(req: Request) {
+  if (!isApiRequestAllowed(req)) return response({ error: "Untrusted API request" }, 403);
+  try {
+    const cwd = new URL(req.url).searchParams.get("cwd") ?? undefined;
+    if (!validCwd(cwd)) return response({ error: "Invalid working directory" }, 400);
+    const current = await context(cwd);
+    if (!current) return response({ error: "請先在插件設定安裝 Agent Connect，並選擇可存取的工作目錄。" }, 404);
+    return response(current.api ? paseoPublicStatus({ ...await current.api.status(), packageEnabled: true, packageInstalled: true }) : { phase: "disabled", packageEnabled: false, packageInstalled: true });
+  } catch {
+    return response({ error: "Agent Connect 狀態暫時無法取得；請檢查插件安裝與服務。" }, 503);
+  }
+}
+
+export async function POST(req: Request) {
+  if (!isApiRequestAllowed(req)) return response({ error: "Untrusted API request" }, 403);
+  if (!hasJsonContentType(req)) return response({ error: "Content-Type must be application/json" }, 415);
+  try {
+    const body = await readJsonObject(req, MAX_BODY_BYTES);
+    if (typeof body.action !== "string" || !["status", "activate", "disable", "diagnose", "pair", "config", "models"].includes(body.action)) return response({ error: "Unsupported action" }, 400);
+    if (!validCwd(body.cwd)) return response({ error: "Invalid working directory" }, 400);
+    if (body.action === "models" && (typeof body.provider !== "string" || !["claude", "codex", "pi"].includes(body.provider))) return response({ error: "Unsupported provider" }, 400);
+    const config = body.action === "config" ? readPaseoConfig(body.config) : undefined;
+    if (body.action === "config" && !config) return response({ error: "設定只接受有效的主機備註、連線標的與代理協作開關。" }, 400);
+    const operation = async () => {
+      const current = await context(body.cwd);
+      if (!current) return response({ error: "Agent Connect 插件尚未安裝，或工作目錄無法存取。" }, 404);
+      const { api, cwd, target, packages } = current;
+      if (!api) return response({ error: "請先在插件設定啟用 Agent Connect。" }, 409);
+      const publicStatus = async () => paseoPublicStatus({ ...await api.status(), packageEnabled: true, packageInstalled: true });
+      if (body.action === "status") return response(await publicStatus());
+      if (body.action === "diagnose") return response({ checks: paseoDiagnosticChecks(await api.diagnostics()) });
+      if (body.action === "models") {
+        if (!api.listModels) return response({ error: "目前插件未提供模型目錄；請開啟所選平台選擇模型與模式。" }, 501);
+        return response(paseoModelCatalog(await api.listModels(String(body.provider)), String(body.provider)));
+      }
+      if (body.action === "pair") {
+        if (target.disabled) return response({ error: "請先在插件設定啟用 Agent Connect。" }, 409);
+        const result = await api.pair();
+        const pairTarget = result.target ?? "paseo";
+        const url = isConnectionTarget(pairTarget) ? safePaseoPairUrl(result.url, pairTarget) : null;
+        if (!url) return response({ error: "連線平台未提供有效的配對連結。" }, 502);
+        return response({ url, target: pairTarget, ...(typeof result.expiresAt === "string" && /^\d{4}-\d{2}-\d{2}T[\d:.]+Z$/.test(result.expiresAt) ? { expiresAt: result.expiresAt } : {}) });
+      }
+      if (body.action === "config") {
+        const saved = await api.saveConfig(config!);
+        // Only the validated outcome of a collaboration change crosses the boundary.
+        const applied = agentCollaborationResult(saved?.agentCollaborationApplied);
+        return response({ ...await publicStatus(), ...(applied ? { agentCollaborationApplied: applied } : {}) });
+      }
+      if (body.action === "activate" && target.disabled) return response({ error: "請先在插件設定啟用 Agent Connect。" }, 409);
+      const result = await api.lifecycle({ action: body.action === "disable" ? "disable" : "enable", cwd, source: target.source, scope: target.scope, packages: body.action === "disable" ? [] : packages });
+      return response(paseoLifecycleResult(result));
+    };
+    // Runtime reads are independently bounded. A model/provider lookup can
+    // take minutes and must not hold the package/lifecycle mutation chain.
+    return await (["status", "diagnose", "models"].includes(body.action) ? operation() : serializePluginPackageOperation(operation));
+  } catch (failure) {
+    if (failure instanceof RequestBodyError) return response({ error: failure.message }, failure.status);
+    // Do not return exception strings: CLI output can contain pairing secrets.
+    return response({ error: "Agent Connect 操作尚未完成；請檢查診斷並重試。" }, 503);
+  }
+}
