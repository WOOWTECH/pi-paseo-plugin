--- /dev/null
+++ b/lib/paseo-onboarding.ts
@@ -0,0 +1,23 @@
+import type { SessionManager } from "@earendil-works/pi-coding-agent";
+
+type OnboardingSession = {
+  send: (command: Record<string, unknown>) => Promise<unknown>;
+  inner: { sessionManager: SessionManager };
+};
+
+/** Persist the authorized request even when model preflight rejects it. */
+export async function promptPaseoOnboarding(session: OnboardingSession, message: string): Promise<boolean> {
+  const state = await session.send({ type: "get_state" }) as { model?: unknown };
+  if (state.model) {
+    try {
+      await session.send({ type: "prompt", message });
+      return false;
+    } catch { /* Record the request below if preflight did not persist it. */ }
+  }
+  const manager = session.inner.sessionManager;
+  if (!manager.getEntries().some((entry) => entry.type === "message" && entry.message.role === "user")) {
+    manager.appendMessage({ role: "user", content: message, timestamp: Date.now() });
+    return true;
+  }
+  return true;
+}
diff --git a/lib/paseo-package.ts b/lib/paseo-package.ts
new file mode 100644
index 0000000..e2460bb
--- /dev/null
+++ b/lib/paseo-package.ts
@@ -0,0 +1,34 @@
+import { dirname, isAbsolute, join, relative, resolve, sep } from "node:path";
+import { realpathSync, statSync } from "node:fs";
+import { pathToFileURL } from "node:url";
+import { readRegularFileText } from "./regular-file";
+import { PASEO_PACKAGE_NAME, type PaseoPackageRef } from "./paseo-plugin-lifecycle";
+
+export function paseoPackageRoot(installedPath: string): string {
+  return realpathSync(statSync(installedPath).isDirectory() ? installedPath : dirname(installedPath));
+}
+
+export function readPaseoPackageManifest(root: string): Record<string, unknown> {
+  const manifest = JSON.parse(readRegularFileText(join(root, "package.json"), 1024 * 1024) ?? "{}");
+  if (!manifest || manifest.name !== PASEO_PACKAGE_NAME) throw new Error("Paseo package identity unavailable");
+  return manifest;
+}
+
+/** Resolve the declared API inside the installed package, never an environment override. */
+export function paseoHostApiUrl(pkg: PaseoPackageRef, allowDisabled = false): string {
+  if (!pkg.installedPath || !isAbsolute(pkg.installedPath) || (pkg.disabled && !allowDisabled)) {
+    throw new Error("Enabled installed Paseo package required");
+  }
+  const root = paseoPackageRoot(pkg.installedPath);
+  const manifest = readPaseoPackageManifest(root);
+  const declaration = manifest.piPaseo as { hostApi?: unknown } | undefined;
+  const exports = manifest.exports as Record<string, unknown> | undefined;
+  const entry = declaration?.hostApi ?? exports?.["./host-api"];
+  if (typeof entry !== "string" || !entry.startsWith("./") || entry.includes("\\")) throw new Error("Paseo host API must be declared by its package");
+  const file = realpathSync(resolve(root, entry));
+  const rel = relative(root, file);
+  if (!rel || rel === ".." || rel.startsWith(`..${sep}`) || isAbsolute(rel) || !statSync(file).isFile()) throw new Error("Paseo host API must stay inside its package");
+  const url = pathToFileURL(file);
+  url.searchParams.set("revision", `${manifest.version ?? ""}:${statSync(file).mtimeMs}`);
+  return url.href;
+}
