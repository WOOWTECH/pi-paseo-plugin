+"use client";
+
+import { useCallback, useEffect, useRef, useState } from "react";
+import { ConfigButton, ConfigDetailActions, ConfigDetailGrid, ConfigDetailGridRow, ConfigFooterStatus, ConfigSectionTitle, ConfigSwitch } from "./SettingsUi";
+import { PASEO_PROVIDERS, CONNECTION_TARGETS, connectionTarget, isConnectionTarget, type ConnectionTarget, paseoModelCatalog, paseoProviderLabel, paseoPublicStatus, safePaseoPairUrl, agentCollaborationResult, type PaseoConfigInput, type PaseoModelCatalog, type PaseoPublicStatus } from "@/lib/paseo-ui";
+
+const STATUS_FRESH_MS = 15_000;
+const START_WAIT_MS = 120_000;
+const REQUEST_TIMEOUT_MS = 30_000;
+const DISABLE_TIMEOUT_MS = 120_000;
+const REQUEST_TIMEOUT_MESSAGE = "Agent Connect 要求逾時；操作結果尚未確認。請重新整理狀態後再決定下一步。";
+
+const PHASE_LABELS: Record<string, string> = {
+  restart_required: "需要重新啟動；請先停止 Agent Connect 服務，再按「啟動服務」。",
+  disabled: "已停用", idle: "等待啟動", installing: "下載安裝中", activating: "正在啟動", starting: "正在啟動",
+  not_installed: "尚未安裝", stopped: "服務已停止", ready: "服務已啟動", running: "服務已啟動", paired: "已配對", complete: "服務已就緒", error: "需要處理", failed: "需要處理",
+};
+
+async function request(cwd: string, action?: string, config?: PaseoConfigInput, provider?: string): Promise<Record<string, unknown>> {
+  const controller = new AbortController();
+  const timeoutMs = action === "disable" ? DISABLE_TIMEOUT_MS : REQUEST_TIMEOUT_MS;
+  let timedOut = false;
+  let timeout: ReturnType<typeof setTimeout> | undefined;
+  const requestResult = async (): Promise<Record<string, unknown>> => {
+    const response = action
+      ? await fetch("/api/plugin-paseo", { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify({ cwd, action, ...(config ? { config } : {}), ...(provider ? { provider } : {}) }), cache: "no-store", signal: controller.signal })
+      : await fetch(`/api/plugin-paseo${cwd ? `?cwd=${encodeURIComponent(cwd)}` : ""}`, { cache: "no-store", signal: controller.signal });
+    let result: Record<string, unknown>;
+    try { result = await response.json(); } catch { throw new Error("Agent Connect 操作暫時無法完成。請重新登入 Pi Web 後重試。"); }
+    if (!result || typeof result !== "object" || Array.isArray(result)) throw new Error("Agent Connect 操作暫時無法完成。");
+    if (!response.ok || result.error) throw new Error(typeof result.error === "string" ? result.error : "Agent Connect 操作暫時無法完成。");
+    return result;
+  };
+  try {
+    return await Promise.race([
+      requestResult(),
+      new Promise<never>((_resolve, reject) => {
+        timeout = setTimeout(() => {
+          timedOut = true;
+          controller.abort();
+          reject(new Error(REQUEST_TIMEOUT_MESSAGE));
+        }, timeoutMs);
+      }),
+    ]);
+  } catch (failure) {
+    if (timedOut) throw new Error(REQUEST_TIMEOUT_MESSAGE);
+    throw failure;
+  } finally {
+    if (timeout !== undefined) clearTimeout(timeout);
+  }
+}
+
+export function PaseoPluginPanel({ cwd = "", disabled = false }: { cwd?: string; disabled?: boolean }) {
+  const [status, setStatus] = useState<PaseoPublicStatus>({});
+  const [busy, setBusy] = useState("");
+  const [error, setError] = useState("");
+  const [notice, setNotice] = useState("");
+  const [pairUrl, setPairUrl] = useState<string | null>(null);
+  const [checks, setChecks] = useState<Array<{ name: string; status: string; message?: string }>>([]);
+  const [name, setName] = useState("");
+  const [target, setTarget] = useState<ConnectionTarget>("paseo");
+  const [collaboration, setCollaboration] = useState(false);
+  const [catalogs, setCatalogs] = useState<PaseoModelCatalog[]>([]);
+  const [statusCurrent, setStatusCurrent] = useState(false);
+  const [startWaiting, setStartWaiting] = useState(false);
+  const [startUnconfirmed, setStartUnconfirmed] = useState(false);
+  const requestVersions = useRef({ workspace: 0, refresh: 0, action: 0, mutation: false, pendingRefresh: 0 });
+  const startTracking = useRef<{ workspace: number; target: string; statusReads: number; timer: ReturnType<typeof setTimeout> } | null>(null);
+  const unconfirmedStart = useRef<{ workspace: number; target: string } | null>(null);
+  const nameEdited = useRef(false);
+  const targetEdited = useRef(false);
+  const collaborationEdited = useRef(false);
+  const observedTarget = useRef("paseo");
+  const savedTarget = connectionTarget(status.configuration?.target ?? status.selectedTarget);
+  const targetDirty = target !== savedTarget.id;
+  const activeTarget = isConnectionTarget(status.activeTarget) ? connectionTarget(status.activeTarget) : undefined;
+  const targetApplicationPending = Boolean(status.configurationPending || (activeTarget && activeTarget.id !== savedTarget.id));
+  const liveDaemon = status.daemon?.running === true;
+  const activateBlocked = targetDirty || (liveDaemon && targetApplicationPending);
+  const activateBlockMessage = targetDirty
+    ? "請先儲存連線標的，才能啟動服務。未儲存的標的不會套用。"
+    : liveDaemon && targetApplicationPending
+      ? `目前執行標的：${activeTarget?.label ?? "尚未確認"}；已儲存標的：${savedTarget.label}。請先停止服務，再啟動以套用變更。`
+      : "";
+  // Older Agent Connect runtimes do not report the switch; they get neither the
+  // control nor the field, so their saves stay exactly as before.
+  const collaborationSupported = typeof status.configuration?.agentCollaboration === "boolean";
+  const savedCollaboration = status.configuration?.agentCollaboration === true;
+  const collaborationDirty = collaborationSupported && collaboration !== savedCollaboration;
+  const lastStatusAt = useRef(0);
+
+  const clearStartTracking = (updateState = true) => {
+    if (startTracking.current) clearTimeout(startTracking.current.timer);
+    startTracking.current = null;
+    unconfirmedStart.current = null;
+    if (updateState) { setStartWaiting(false); setStartUnconfirmed(false); }
+  };
+
+  const beginStartTracking = (workspace: number, targetId: string) => {
+    clearStartTracking(false);
+    const tracking = { workspace, target: targetId, statusReads: 0, timer: undefined as unknown as ReturnType<typeof setTimeout> };
+    tracking.timer = setTimeout(() => {
+      if (startTracking.current !== tracking) return;
+      startTracking.current = null;
+      setStartWaiting(false);
+      unconfirmedStart.current = { workspace, target: targetId };
+      setStartUnconfirmed(true);
+      setNotice("啟動要求逾時，結果尚未確認；請重新整理狀態。本頁不會自動重送啟動。");
+    }, START_WAIT_MS);
+    startTracking.current = tracking;
+    setStartWaiting(true);
+  };
+
+  const refresh = useCallback(async () => {
+    const versions = requestVersions.current;
+    if (versions.mutation || versions.pendingRefresh === versions.refresh && versions.pendingRefresh !== 0) return;
+    const workspace = versions.workspace, version = ++versions.refresh;
+    versions.pendingRefresh = version;
+    try {
+      const next = paseoPublicStatus(await request(cwd));
+      if (workspace !== versions.workspace || version !== versions.refresh) return;
+      lastStatusAt.current = Date.now();
+      const nextTarget = next.configuration?.target ?? next.selectedTarget ?? "paseo";
+      const tracking = startTracking.current;
+      const uncertain = unconfirmedStart.current;
+      const watchedStart = tracking?.workspace === workspace ? tracking : uncertain?.workspace === workspace ? uncertain : null;
+      if (watchedStart) {
+        if (tracking?.workspace === workspace) tracking.statusReads++;
+        const savedChanged = nextTarget !== watchedStart.target;
+        const terminal = next.phase === "error" || next.phase === "failed";
+        const restartRequired = next.phase === "restart_required" && !next.configurationPending;
+        // host-api.lifecycle can acknowledge scheduling before runtime.activate
+        // updates desiredEnabled/phase. Its first status read may still be stale.
+        const terminalConfirmed = terminal && (!tracking || tracking.statusReads > 1);
+        const healthy = next.enabled !== false && next.daemon?.healthy === true && !next.configurationPending;
+        const activeMatches = !next.activeTarget || next.activeTarget === watchedStart.target;
+        const ready = next.phase !== "restart_required" && healthy && activeMatches;
+        const activeChangedAfterReady = next.phase !== "restart_required" && healthy && Boolean(next.activeTarget) && !activeMatches;
+        // A stopped snapshot immediately after `scheduled: true` can be stale.
+        // Only use it to resolve a direct request timeout's unknown result; the
+        // accepted background start remains tracked until readiness/error/change/deadline.
+        const confirmedStopped = !tracking && Boolean(uncertain) && next.enabled === false && next.daemon?.running !== true;
+        if (savedChanged || terminalConfirmed || restartRequired || ready || activeChangedAfterReady || confirmedStopped) {
+          clearStartTracking();
+          if (savedChanged || activeChangedAfterReady) setNotice("連線標的已變更；已解除啟動等待。請確認目前與已儲存的標的。");
+          else if (terminalConfirmed) setNotice("啟動服務回報失敗；請檢查診斷後再決定下一步。");
+          else if (restartRequired) setNotice("Agent Connect 需要重新啟動；請先停止服務，再手動啟動。");
+          else if (ready) setNotice("Agent Connect 服務已確認就緒。");
+          else if (confirmedStopped) setNotice("已確認服務尚未啟動；檢查狀態後可手動重試。");
+        }
+      }
+      if (observedTarget.current !== nextTarget || next.configurationPending) { setPairUrl(null); setCatalogs([]); }
