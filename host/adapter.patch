diff --git a/app/paseo/setup/page.tsx b/app/paseo/setup/page.tsx
new file mode 100644
index 0000000..dd4dfc5
--- /dev/null
+++ b/app/paseo/setup/page.tsx
@@ -0,0 +1,16 @@
+import Link from "next/link";
+import { PaseoPluginPanel } from "@/components/PaseoPluginPanel";
+
+export const dynamic = "force-dynamic";
+
+export default async function PaseoSetupPage({ searchParams }: { searchParams: Promise<{ cwd?: string }> }) {
+  const { cwd } = await searchParams;
+  return (
+    <main style={{ minHeight: "100dvh", background: "var(--bg)", color: "var(--text)", padding: "32px 20px" }}>
+      <div style={{ maxWidth: 780, margin: "0 auto", display: "flex", flexDirection: "column", gap: 24 }}>
+        <header><Link href="/" style={{ fontSize: 13 }}>← 回到 Pi Web</Link><h1 style={{ fontSize: 24, marginBottom: 8 }}>Paseo 初始化與連線</h1><p style={{ fontSize: 13, color: "var(--text-muted)", lineHeight: 1.7 }}>首次安裝／啟用會自動建立初始化對話；未完成時可續接同一對話。此頁沿用 Pi Web 的登入保護。</p></header>
+        <PaseoPluginPanel cwd={typeof cwd === "string" ? cwd : ""} setup />
+      </div>
+    </main>
+  );
+}
diff --git a/components/PaseoPluginPanel.tsx b/components/PaseoPluginPanel.tsx
new file mode 100644
index 0000000..09dd792
--- /dev/null
+++ b/components/PaseoPluginPanel.tsx
@@ -0,0 +1,157 @@
+"use client";
+
+import { useCallback, useEffect, useState } from "react";
+import Link from "next/link";
+import { ConfigButton, ConfigDetailActions, ConfigDetailGrid, ConfigDetailGridRow, ConfigFooterStatus, ConfigSectionTitle } from "./SettingsUi";
+import { PASEO_APP_URL, PASEO_PROVIDERS, paseoModelCatalog, paseoProviderLabel, paseoPublicStatus, paseoSessionUrl, safePaseoPairUrl, type PaseoModelCatalog, type PaseoPublicStatus } from "@/lib/paseo-ui";
+
+const PHASE_LABELS: Record<string, string> = {
+  disabled: "已停用", idle: "等待初始化", installing: "下載安裝中", activating: "正在啟動", starting: "正在啟動",
+  not_installed: "尚未安裝", stopped: "服務已停止", ready: "服務已啟動", running: "服務已啟動", paired: "已配對", complete: "初始化完成", error: "需要處理", failed: "需要處理",
+};
+
+async function request(cwd: string, action?: string, config?: Record<string, string>, provider?: string): Promise<Record<string, unknown>> {
+  const response = action
+    ? await fetch("/api/plugin-paseo", { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify({ cwd, action, ...(config ? { config } : {}), ...(provider ? { provider } : {}) }), cache: "no-store" })
+    : await fetch(`/api/plugin-paseo${cwd ? `?cwd=${encodeURIComponent(cwd)}` : ""}`, { cache: "no-store" });
+  let result: Record<string, unknown>;
+  try { result = await response.json(); } catch { throw new Error("Paseo 操作暫時無法完成。請重新登入 Pi Web 後重試。"); }
+  if (!response.ok) throw new Error(typeof result.error === "string" ? result.error : "Paseo 操作暫時無法完成。");
+  return result;
+}
+
+export function PaseoPluginPanel({ cwd = "", disabled = false, setup = false }: { cwd?: string; disabled?: boolean; setup?: boolean }) {
+  const [status, setStatus] = useState<PaseoPublicStatus>({});
+  const [busy, setBusy] = useState("");
+  const [error, setError] = useState("");
+  const [notice, setNotice] = useState("");
+  const [pairUrl, setPairUrl] = useState<string | null>(null);
+  const [checks, setChecks] = useState<Array<{ name: string; status: string; message?: string }>>([]);
+  const [name, setName] = useState("");
+  const [catalogs, setCatalogs] = useState<PaseoModelCatalog[]>([]);
+
+  const refresh = useCallback(async () => {
+    try {
+      const next = paseoPublicStatus(await request(cwd));
+      setStatus(next);
+      setError("");
+      if (next.configuration?.name) setName((value) => value || next.configuration!.name!);
+    } catch (failure) {
+      setError(failure instanceof Error ? failure.message : "Paseo 狀態暫時無法取得。");
+    }
+  }, [cwd]);
+
+  useEffect(() => { setPairUrl(null); setChecks([]); setCatalogs([]); setName(""); setStatus({}); void refresh(); }, [refresh]);
+  useEffect(() => {
+    if (disabled || status.packageEnabled === false) return;
+    const timer = setInterval(() => { if (!document.hidden) void refresh(); }, 5000);
+    return () => clearInterval(timer);
+  }, [disabled, status.packageEnabled, refresh]);
+  useEffect(() => { if (disabled || status.enabled === false) setPairUrl(null); }, [disabled, status.enabled]);
+
+  const action = async (kind: "activate" | "disable" | "diagnose" | "pair" | "config" | "models", provider?: string) => {
+    setBusy(kind);
+    if (kind === "pair" || kind === "disable") setPairUrl(null);
+    setError("");
+    setNotice("");
+    try {
+      const config = kind === "config" ? { ...(name.trim() ? { name: name.trim() } : {}) } : undefined;
+      const result = await request(cwd, kind, config, provider);
+      if (kind === "pair") {
+        const url = safePaseoPairUrl(result.url);
+        if (!url) throw new Error("尚未取得有效的官方配對連結。");
+        setPairUrl(url);
+        setNotice("已產生配對連結。請開啟 Paseo 完成配對；配對連結只保留在這個畫面。");
+      } else if (kind === "models" && provider) {
+        const catalog = paseoModelCatalog(result, provider);
+        setCatalogs((current) => [...current.filter((item) => item.provider !== provider), catalog]);
+        setNotice("已取得 Paseo 實際模型與模式；請在 Paseo 選擇後開始對話。");
+      } else if (kind === "diagnose") {
+        const entries = Array.isArray(result.checks) ? result.checks : [];
+        setChecks(entries.flatMap((entry) => {
+          if (!entry || typeof entry !== "object") return [];
+          const value = entry as Record<string, unknown>;
+          return typeof value.name === "string" && typeof value.status === "string"
+            ? [{ name: value.name, status: value.status, ...(typeof value.message === "string" ? { message: value.message } : {}) }]
+            : [];
+        }));
+        setNotice("診斷已更新。提供者仍需各自完成登入與實際對話驗證。");
+      } else {
+        if (paseoSessionUrl(result.onboardingSessionId)) setStatus((current) => ({ ...current, onboardingSessionId: result.onboardingSessionId as string }));
+        setNotice(kind === "config" ? "設定已儲存。" : kind === "disable" ? "已要求停止 Paseo 服務。" : "初始化已排入背景處理；請繼續初始化對話。" );
+      }
+      await refresh();
+    } catch (failure) {
+      setError(failure instanceof Error ? failure.message : "Paseo 操作尚未完成。");
+    } finally { setBusy(""); }
+  };
+
+  const sessionUrl = paseoSessionUrl(status.onboardingSessionId);
+  const packageDisabled = disabled || status.packageEnabled === false;
+  return (
+    <section style={{ display: "flex", flexDirection: "column", gap: 12 }} aria-label="Paseo 連線設定">
+      <ConfigSectionTitle>Paseo 連線</ConfigSectionTitle>
+      <p style={{ fontSize: 13, color: "var(--text-muted)", margin: 0, lineHeight: 1.7 }}>
+        在 Paseo 操作這個容器的 Claude Code、Codex 與 Pi。沿用現有登入、模型與權限，透過官方 relay 配對。
+      </p>
+      <ConfigDetailGrid>
+        <ConfigDetailGridRow label="初始化狀態">{disabled ? "插件已停用" : PHASE_LABELS[status.phase ?? ""] ?? status.phase ?? "尚未取得"}</ConfigDetailGridRow>
+        <ConfigDetailGridRow label="Paseo 服務">{status.daemon?.healthy ? "連線正常" : status.daemon?.running ? "程序執行中，等待連線確認" : status.daemon?.running === false ? "尚未啟動" : "尚未確認"}</ConfigDetailGridRow>
+        <ConfigDetailGridRow label="Pi 插件">{status.packageInstalled ? (packageDisabled ? "已安裝／已停用" : "已安裝／已啟用") : "尚未確認"}</ConfigDetailGridRow>
+        <ConfigDetailGridRow label="Paseo 安裝">{status.daemon?.installed ? "已安裝" : "尚未確認"}</ConfigDetailGridRow>
+        <ConfigDetailGridRow label="官方 relay 目前連線">{status.daemon?.relayConnected === true ? "已連線" : status.daemon?.relayConnected === false ? "未連線" : "尚未取得即時連線狀態"}</ConfigDetailGridRow>
+        {status.daemon?.relayVerifiedAt && <ConfigDetailGridRow label="relay 上次驗證時間">{status.daemon.relayVerifiedAt}（歷史紀錄）</ConfigDetailGridRow>}
+        {PASEO_PROVIDERS.map((provider) => {
+          const found = status.providers?.find((entry) => entry.id === provider.id || (provider.id === "claude" && entry.id === "claude-code"));
+          return <ConfigDetailGridRow key={provider.id} label={provider.label}>{paseoProviderLabel(found)}{found?.modes?.length ? `；模式：${found.modes.map((mode) => mode.label).join("、")}` : ""}</ConfigDetailGridRow>;
+        })}
+      </ConfigDetailGrid>
+      <ConfigDetailActions>
+        {!setup && <Link href={`/paseo/setup?cwd=${encodeURIComponent(cwd)}`} target="_blank" rel="noopener noreferrer" className="config-button config-button-secondary config-button-default">設定 Paseo</Link>}
+        <ConfigButton onClick={() => void refresh()} disabled={Boolean(busy)}>重新整理</ConfigButton>
+        <ConfigButton onClick={() => void action("diagnose")} disabled={Boolean(busy)}>{busy === "diagnose" ? "診斷中…" : "檢查診斷"}</ConfigButton>
+        <ConfigButton onClick={() => void action("activate")} disabled={Boolean(busy) || packageDisabled}>{busy === "activate" ? "啟動中…" : "啟動／繼續初始化"}</ConfigButton>
+        <ConfigButton onClick={() => void action("disable")} disabled={Boolean(busy) || packageDisabled || status.enabled === false}>{busy === "disable" ? "停止中…" : "停止 Paseo 服務"}</ConfigButton>
+        {sessionUrl && <Link href={sessionUrl} className="config-button config-button-secondary config-button-default" target="_blank" rel="noopener noreferrer">開啟初始化對話</Link>}
+        <a href={PASEO_APP_URL} target="_blank" rel="noopener noreferrer" className="config-button config-button-secondary config-button-default">開啟 Paseo</a>
+      </ConfigDetailActions>
