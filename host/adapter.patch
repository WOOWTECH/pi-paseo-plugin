+import assert from "node:assert/strict";
+import fs from "node:fs";
+import path from "node:path";
+import vm from "node:vm";
+import { EventEmitter } from "node:events";
+import { fileURLToPath, pathToFileURL } from "node:url";
+import test from "node:test";
+import ts from "typescript";
+import * as lifecycle from "./paseo-plugin-lifecycle.ts";
+
+const directory = path.dirname(fileURLToPath(import.meta.url));
+const home = "/fixture/home";
+const projectCwd = "/fixture/project";
+const globalPackage = { source: "/fixture/global-paseo", scope: "global", installedPath: "/fixture/global-paseo", packageName: lifecycle.PASEO_PACKAGE_NAME, disabled: false };
+const projectPackage = { ...globalPackage, source: "/fixture/project-paseo", scope: "project", installedPath: "/fixture/project-paseo" };
+
+// Run the actual host modules with isolated SDK, API and session boundaries.
+// No account files, services or model requests are used by these regressions.
+function fixture({ enabled = true, desiredEnabled = enabled, globals = [globalPackage], projects = [], env = {}, trusted = true, existing = [home, projectCwd], files = [], stopFailure = false, owner = globals.find((pkg) => pkg.packageName === lifecycle.PASEO_PACKAGE_NAME) ?? projects[0] } = {}) {
+  const calls = [];
+  const discoveries = [];
+  const pathChecks = [];
+  const trustChecks = [];
+  const state = { enabled: desiredEnabled, running: desiredEnabled, onboardingSessionId: "existing-session" };
+  const records = new Map([["host-registration", { enabled, cwd: projectCwd }]]);
+  const processes = new Map();
+  const signals = [];
+  let nextPid = 200;
+  const packages = [...globals, ...projects];
+  const apis = new Map();
+  const stateDir = path.resolve(env.PI_PASEO_STATE_DIR || "/fixture/agent/pi-paseo");
+  if ((enabled || desiredEnabled) && owner) {
+    const pid = ++nextPid;
+    processes.set(pid, { root: owner.installedPath, identity: `birth-${pid}`, argv: ["/fixture/node", path.join(owner.installedPath, "bin/cli.mjs"), "supervise"] });
+    records.set("supervisor", { pid, identity: `birth-${pid}`, packageRoot: owner.installedPath });
+  }
+  const entry = (pkg) => pkg.disabled ? { source: pkg.source, extensions: [], skills: [], prompts: [], themes: [] } : pkg.source;
+  const stubs = {
+    "node:crypto": { randomUUID: () => "fixture-session" },
+    "node:os": { homedir: () => home },
+    "node:path": path,
+    "node:fs": { statSync(file) {
+      pathChecks.push(file);
+      if (existing.includes(file)) return { isDirectory: () => true };
+      if (files.includes(file)) return { isDirectory: () => false };
+      throw Object.assign(new Error("Fixture path missing"), { code: "ENOENT" });
+    }, existsSync: () => false },
+    "@earendil-works/pi-coding-agent": {
+      getAgentDir: () => "/fixture/agent",
+      SettingsManager: { create(cwd, _agentDir, options) {
+        discoveries.push({ cwd, projectTrusted: options.projectTrusted });
+        return { projectTrusted: options.projectTrusted, getGlobalSettings: () => ({ packages: globals.map(entry) }), getProjectSettings: () => ({ packages: projects.map(entry) }) };
+      } },
+      DefaultPackageManager: class {
+        constructor(options) { this.settings = options.settingsManager; }
+        listConfiguredPackages() {
+          return [...globals.map((pkg) => ({ ...pkg, scope: "user" })), ...(this.settings.projectTrusted ? projects : [])];
+        }
+      },
+    },
+    "./file-access": { allowFileRoot() {} },
+    "./project-trust": { getProjectTrustStatus(cwd) { trustChecks.push(cwd); return { trusted }; } },
+    "./rpc-manager": { startRpcSession: () => assert.fail("Existing onboarding must be reused") },
+    "./session-reader": { invalidateSessionListCache() {} },
+    "./paseo-onboarding": {},
+    "./plugin-package-lock": { serializePluginPackageOperation: (task) => task() },
+    "./paseo-plugin-lifecycle": lifecycle,
+    "./paseo-package": {
+      paseoPackageRoot: (root) => root,
+      readPaseoPackageManifest(root) {
+        const name = packages.find((pkg) => pkg.installedPath === root)?.packageName;
+        if (name !== lifecycle.PASEO_PACKAGE_NAME) throw new Error("Fixture package identity unavailable");
+        return { name };
+      },
+      paseoHostApiUrl(pkg, allowDisabled) {
+        assert.equal(pkg.packageName, lifecycle.PASEO_PACKAGE_NAME, "Only Paseo bindings can recover its service");
+        assert.ok(allowDisabled || !pkg.disabled);
+        return `fixture-api:${pkg.source}`;
+      },
+    },
+    "./regular-file": { readRegularFileText(file) {
+      assert.equal(file, path.join(stateDir, "host-registration.json"));
+      return JSON.stringify(records.get("host-registration"));
+    } },
+  };
+  const context = vm.createContext({ process: { env: { PI_CODING_AGENT_DIR: "/fixture/agent", ...env } }, console });
+  function load(name) {
+    const file = path.join(directory, name);
+    const source = fs.readFileSync(file, "utf8");
+    const code = ts.transpileModule(source, { compilerOptions: { module: ts.ModuleKind.CommonJS, target: ts.ScriptTarget.ES2022, esModuleInterop: true }, fileName: file + ".ts" }).outputText;
+    const module = { exports: {} };
+    vm.runInContext(`(function(require, module, exports) { ${code}\n })`, context, { filename: file })((specifier) => {
+      if (apis.has(specifier)) return apis.get(specifier);
+      if (Object.hasOwn(stubs, specifier)) return stubs[specifier];
+      throw new Error(`Unexpected fixture dependency: ${specifier}`);
+    }, module, module.exports);
+    return module.exports;
+  }
+  // Keep the root pause and supervisor migration contracts real; replace only
+  // process, storage and daemon work. These modules are read, never changed.
+  const rootDirectory = path.resolve(directory, "../../..");
+  const recordName = (file) => path.basename(file, ".json");
+  const runtime = {
+    locations: () => ({ stateDir, agentDir: "/fixture/agent", home }),
+    status: async () => ({ enabled: state.enabled, daemon: { running: state.running } }),
+    deactivate: async () => { state.enabled = false; state.running = false; },
+  };
+  const rootFs = {
+    realpathSync: (file) => file,
+    readFileSync(file) {
+      const match = /^\/proc\/(\d+)\/cmdline$/.exec(file);
+      if (!match || !processes.has(Number(match[1]))) throw Object.assign(new Error("Fixture process missing"), { code: "ENOENT" });
+      return processes.get(Number(match[1])).argv.join("\0") + "\0";
+    },
+    openSync: () => 42, closeSync() {},
+    existsSync: () => false,
+  };
+  const rootProcess = {
+    platform: "linux", execPath: "/fixture/node", env: {}, cwd: () => projectCwd,
+    kill(pid, signal = "SIGTERM") {
+      if (!processes.has(pid)) throw Object.assign(new Error("Fixture process missing"), { code: "ESRCH" });
+      if (signal !== 0) {
+        if (stopFailure) throw new Error("private-subprocess-output");
+        signals.push(pid);
+        processes.delete(pid);
+      }
+    },
+  };
+  const rootStubs = {
+    "node:fs": rootFs, "node:path": path, "node:url": { fileURLToPath },
+    "@earendil-works/pi-coding-agent": {
+      ...stubs["@earendil-works/pi-coding-agent"],
+      SettingsManager: { create: () => ({ projectTrusted: true, getGlobalSettings: () => ({ packages: globals.map(entry) }), getProjectSettings: () => ({ packages: projects.map(entry) }) }) },
+    },
+    "./runtime.mjs": runtime,
+    "./state.mjs": { processIdentity: (pid) => processes.get(pid)?.identity ?? null },
+    "./onboarding.mjs": {
+      readRecord: (file) => ({ ...records.get(recordName(file)) }),
+      writeRecord: (file, value) => records.set(recordName(file), value),
+      withLock: async (_file, task) => task(),
+      onboardingStatus: () => ({ sessionId: state.onboardingSessionId }),
+      ensureOnboarding: async () => ({ sessionId: state.onboardingSessionId }),
+    },
+    "node:child_process": { spawn(_command, argv) {
+      const pid = ++nextPid;
+      const root = path.dirname(path.dirname(argv[0]));
+      processes.set(pid, { root, identity: `birth-${pid}`, argv: [rootProcess.execPath, ...argv] });
+      state.enabled = true;
+      state.running = true;
+      const child = Object.assign(new EventEmitter(), { pid, unref() {} });
+      queueMicrotask(() => child.emit("spawn"));
+      return child;
+    } },
+  };
+  function loadRoot(name, pkg, dependencies) {
+    const file = path.join(rootDirectory, "src", name);
+    const source = fs.readFileSync(file, "utf8").replaceAll("import.meta.url", JSON.stringify(pathToFileURL(path.join(pkg.installedPath, "src", name)).href));
+    const code = ts.transpileModule(source, { compilerOptions: { module: ts.ModuleKind.CommonJS, target: ts.ScriptTarget.ES2022, esModuleInterop: true }, fileName: file + ".ts" }).outputText;
+    const module = { exports: {} };
+    vm.runInNewContext(`(function(require, module, exports) { ${code}\n })`, { process: rootProcess, console, setTimeout, clearTimeout }, { filename: file })((specifier) => {
+      assert.ok(Object.hasOwn(dependencies, specifier), `Unexpected root dependency: ${specifier}`);
+      return dependencies[specifier];
+    }, module, module.exports);
+    return module.exports;
+  }
+  for (const pkg of packages.filter((entry) => entry.packageName === lifecycle.PASEO_PACKAGE_NAME)) {
+    const supervisor = loadRoot("supervisor.mjs", pkg, rootStubs);
+    const api = loadRoot("host-api.mjs", pkg, { ...rootStubs, "./supervisor.mjs": supervisor });
+    apis.set(`fixture-api:${pkg.source}`, {
+      ...api,
+      async lifecycle(input, hooks) { calls.push({ method: "lifecycle", apiSource: pkg.source, ...input }); return api.lifecycle(input, hooks); },
+      async restore(hooks) { calls.push({ method: "restore", apiSource: pkg.source }); return api.restore(hooks); },
+    });
+  }
+  const plugin = load("paseo-plugin.ts");
+  stubs["./paseo-plugin"] = plugin;
+  return { ...plugin, ...load("plugin-lifecycle.ts"), calls, state, discoveries, pathChecks, trustChecks, records, processes, signals };
+}
+
+test("failed last-binding removal resumes the previously enabled service and its onboarding", async () => {
+  const unrelated = { ...globalPackage, source: "/fixture/unrelated", installedPath: "/fixture/unrelated", packageName: "unrelated" };
+  const f = fixture({ globals: [unrelated, globalPackage] });
+  const removal = await f.preparePluginPackageRemoval(projectCwd, [unrelated, globalPackage], globalPackage.source, "global");
+  assert.equal(f.state.running, false);
+  // /api/plugins calls recover when removeAndPersist or its settings write fails.
+  await removal.recover();
+  assert.equal(f.state.enabled, true);
+  assert.equal(f.state.running, true);
+  assert.equal(f.state.onboardingSessionId, "existing-session");
+  assert.deepEqual(f.calls.map((call) => call.action), ["remove", "enable"]);
+});
+
+test("failed last-binding removal preserves an existing manual stop", async () => {
+  const f = fixture({ enabled: false });
+  const removal = await f.preparePluginPackageRemoval(projectCwd, [globalPackage], globalPackage.source, "global");
+  await removal.recover();
+  assert.equal(f.state.enabled, false);
+  assert.equal(f.state.running, false);
+  assert.ok(!f.calls.some((call) => call.action === "enable"));
+});
+
+test("removal recovery reads pause metadata from the configured state directory", async () => {
+  const f = fixture({ enabled: false, desiredEnabled: true, env: { PI_PASEO_STATE_DIR: "/fixture/custom-state" } });
+  const removal = await f.preparePluginPackageRemoval(projectCwd, [globalPackage], globalPackage.source, "global");
+  await removal.recover();
+  assert.equal(f.records.get("host-registration").enabled, false);
+  assert.equal(f.state.running, false);
+});
+
+test("invalid pause metadata blocks cleanup rather than guessing or exposing its contents", async () => {
+  const f = fixture();
+  f.records.set("host-registration", { enabled: "private-registration-value" });
+  await assert.rejects(f.preparePluginPackageRemoval(projectCwd, [globalPackage], globalPackage.source, "global"), (error) => {
+    assert.match(error.message, /Paseo/);
+    assert.doesNotMatch(error.message, /private/);
+    return true;
+  });
+  assert.deepEqual(f.calls, []);
+  assert.equal(f.state.running, true);
+});
+
+for (const [enabled, desiredEnabled] of [[false, true], [true, false]]) {
+  test(`failed removal preserves registration intent while runtime status lags (enabled=${enabled}, desiredEnabled=${desiredEnabled})`, async () => {
+    const f = fixture({ enabled, desiredEnabled });
+    const removal = await f.preparePluginPackageRemoval(projectCwd, [globalPackage], globalPackage.source, "global");
+    await removal.recover();
+    assert.equal(f.records.get("host-registration").enabled, enabled);
+    assert.equal(f.state.running, enabled);
+    assert.equal(f.calls.some((call) => call.action === "enable"), enabled);
+  });
+}
+
+test("a remaining binding must stop the old supervisor successfully before deletion is permitted", async () => {
+  const f = fixture({ projects: [projectPackage], owner: projectPackage, stopFailure: true });
+  const oldPid = f.records.get("supervisor").pid;
+  await assert.rejects(f.preparePluginPackageRemoval(projectCwd, [globalPackage, projectPackage], projectPackage.source, "project"), (error) => {
+    assert.match(error.message, /Paseo/);
+    assert.doesNotMatch(error.message, /private-subprocess-output/);
+    return true;
+  });
+  assert.equal(f.processes.has(oldPid), true);
+  assert.equal(f.processes.size, 1);
+  assert.equal(f.records.get("supervisor").packageRoot, projectPackage.installedPath);
+  assert.ok(!f.calls.some((call) => call.action === "enable"));
+});
+
+for (const [enabled, desiredEnabled] of [[true, true], [false, false], [false, true], [true, false]]) {
+  test(`removing a second registration reconciles the remaining binding before deletion (enabled=${enabled}, desiredEnabled=${desiredEnabled})`, async () => {
+    const projects = [projectPackage];
+    const f = fixture({ enabled, desiredEnabled, projects, owner: projectPackage });
+    const before = [globalPackage, projectPackage];
+    const oldPid = f.records.get("supervisor")?.pid;
+    await f.preparePluginPackageRemoval(projectCwd, before, projectPackage.source, "project");
+    assert.equal(f.state.enabled, enabled);
+    assert.equal(f.state.running, enabled);
+    assert.equal(f.records.get("host-registration").enabled, enabled);
+    assert.deepEqual(f.calls.map((call) => `${call.method}:${call.apiSource}`), [`restore:${globalPackage.source}`]);
+    assert.equal(f.processes.size, enabled ? 1 : 0);
+    assert.ok([...f.processes.values()].every((process) => process.root === globalPackage.installedPath));
+    if (oldPid) {
+      assert.ok(f.signals.includes(oldPid), "Old supervisor must exit before deleting its package");
+      assert.equal(f.processes.has(oldPid), false);
+    }
+    if (enabled) {
+      assert.equal(f.records.get("supervisor").packageRoot, globalPackage.installedPath);
+    }
+    projects.length = 0;
+    await f.applyPaseoPackageLifecycle("remove", projectCwd, before, [globalPackage], [projectPackage]);
+    assert.equal(f.state.enabled, enabled);
+    assert.equal(f.state.running, enabled);
+    assert.equal(f.records.get("host-registration").enabled, enabled);
+    assert.ok(f.calls.every((call) => call.method === "restore"));
+  });
+
+  test(`failed removal with a remaining registration retains the prior service intent (enabled=${enabled}, desiredEnabled=${desiredEnabled})`, async () => {
+    const f = fixture({ enabled, desiredEnabled, projects: [projectPackage], owner: projectPackage });
+    const removal = await f.preparePluginPackageRemoval(projectCwd, [globalPackage, projectPackage], projectPackage.source, "project");
+    // Deletion failed: both bindings are still configured when the receipt runs.
+    await removal.recover();
+    assert.equal(f.records.get("host-registration").enabled, enabled);
+    assert.equal(f.state.enabled, enabled);
+    assert.equal(f.state.running, enabled);
+    assert.equal(f.processes.size, enabled ? 1 : 0);
+    assert.ok([...f.processes.values()].every((process) => process.root === globalPackage.installedPath));
+    assert.ok(f.calls.every((call) => call.method === "restore"));
+  });
+}
+
+for (const enabled of [true, false]) {
+  test(`disabling a second registration preserves the current service choice (enabled=${enabled})`, async () => {
+    const f = fixture({ enabled, projects: [projectPackage] });
+    const result = await f.applyPaseoPackageLifecycle("disable", projectCwd, [globalPackage, projectPackage], [globalPackage, { ...projectPackage, disabled: true }], [projectPackage]);
+    assert.equal(f.state.enabled, enabled);
+    assert.equal(f.state.running, enabled);
+    assert.deepEqual(f.calls.map((call) => call.method), ["restore"]);
+    assert.equal(result.onboardingSessionId, "existing-session");
+  });
+}
+
+test("disabling the final binding still stops the service", async () => {
+  const f = fixture();
+  await f.applyPaseoPackageLifecycle("disable", projectCwd, [globalPackage], [{ ...globalPackage, disabled: true }], [globalPackage]);
+  assert.equal(f.state.running, false);
+  assert.equal(f.calls[0].action, "disable");
+});
+
+test("boot restores an enabled trusted project from the explicit existing cwd once", async () => {
+  const f = fixture({ globals: [], projects: [projectPackage], env: { PI_PASEO_CWD: projectCwd } });
+  await Promise.all([f.restorePaseoPlugin(), f.restorePaseoPlugin()]);
+  assert.deepEqual(f.discoveries, [{ cwd: projectCwd, projectTrusted: true }]);
+  assert.deepEqual(f.pathChecks, [projectCwd]);
+  assert.deepEqual(f.calls.map((call) => `${call.method}:${call.apiSource}`), [`restore:${projectPackage.source}`]);
+});
+
+test("boot respects project trust and preserves a manual stop", async () => {
+  const f = fixture({ enabled: false, projects: [projectPackage], trusted: false, env: { PI_PASEO_CWD: projectCwd } });
+  await f.restorePaseoPlugin();
+  assert.deepEqual(f.discoveries, [{ cwd: projectCwd, projectTrusted: false }]);
+  assert.deepEqual(f.calls.map((call) => call.apiSource), [globalPackage.source]);
+  assert.equal(f.state.running, false);
+});
+
+test("boot never restores an untrusted project-only registration", async () => {
+  const f = fixture({ globals: [], projects: [projectPackage], trusted: false, env: { PI_PASEO_CWD: projectCwd } });
+  await f.restorePaseoPlugin();
+  assert.deepEqual(f.calls, []);
+  assert.deepEqual(f.discoveries, [{ cwd: projectCwd, projectTrusted: false }]);
+});
+
+test("boot skips disabled project bindings even in a trusted explicit cwd", async () => {
+  const f = fixture({ globals: [], projects: [{ ...projectPackage, disabled: true }], env: { PI_PASEO_CWD: projectCwd } });
+  await f.restorePaseoPlugin();
+  assert.deepEqual(f.calls, []);
+});
+
+for (const cwd of [undefined, "relative/project", "/fixture/missing", "/fixture/file"]) {
+  test(`boot without a valid explicit project uses only global bindings (cwd=${cwd})`, async () => {
+    const f = fixture({ projects: [projectPackage], env: cwd === undefined ? {} : { PI_PASEO_CWD: cwd }, files: ["/fixture/file"] });
+    await f.restorePaseoPlugin();
+    assert.deepEqual(f.discoveries, [{ cwd: home, projectTrusted: false }]);
+    assert.deepEqual(f.trustChecks, []);
+    assert.deepEqual(f.calls.map((call) => call.apiSource), [globalPackage.source]);
+  });
+}
diff --git a/lib/paseo-plugin.ts b/lib/paseo-plugin.ts
new file mode 100644
index 0000000..4d225a1
--- /dev/null
+++ b/lib/paseo-plugin.ts
@@ -0,0 +1,128 @@
+import { randomUUID } from "node:crypto";
+import { statSync } from "node:fs";
+import { homedir } from "node:os";
+import { isAbsolute } from "node:path";
+import { DefaultPackageManager, getAgentDir, SettingsManager } from "@earendil-works/pi-coding-agent";
+import { allowFileRoot } from "./file-access";
+import { getProjectTrustStatus } from "./project-trust";
+import { startRpcSession } from "./rpc-manager";
+import { invalidateSessionListCache } from "./session-reader";
+import { paseoHostApiUrl, paseoPackageRoot, readPaseoPackageManifest } from "./paseo-package";
+import { promptPaseoOnboarding } from "./paseo-onboarding";
+import { serializePluginPackageOperation } from "./plugin-package-lock";
+import { dispatchPaseoLifecycle, paseoLifecycleResult, paseoLifecycleTargets, PASEO_PACKAGE_NAME, type PaseoHostApi, type PaseoLifecycleAction, type PaseoLifecycleResult, type PaseoPackageRef } from "./paseo-plugin-lifecycle";
+
+export const PASEO_ONBOARDING_PROMPT = `請協助完成這個容器的 Paseo 連線初始化。插件正在背景安裝與啟動 Paseo，沿用容器內 Claude Code、Codex、Pi 的現有登入與權限。
+請先檢查 Paseo 狀態，說明還需要的連線資訊，並引導我到 /paseo/setup 完成配對與設定。預設使用 Paseo 官方 relay 和 https://app.paseo.sh；官方配對不需要另外提供 Paseo 帳號密碼。
+若提供者尚未登入或登入過期，請引導我使用其官方登入流程。密碼、API Key、配對密鑰與配對連結只能在受保護的設定畫面或官方登入介面輸入，不要要求貼到對話、不要讀取或輸出憑證檔內容。
+完成後分別驗證 Claude Code、Codex、Pi 能在 Paseo 選擇模型與執行模式、新建對話、收到回覆並續聊。不要改成完整權限。`;
+
+type RuntimeState = { apis: Map<string, PaseoHostApi>; restore?: Promise<void> };
+const runtimeGlobal = globalThis as typeof globalThis & { __piPaseoHost?: RuntimeState };
+function runtimeState(): RuntimeState {
+  return runtimeGlobal.__piPaseoHost ??= { apis: new Map() };
+}
+
+export async function createPaseoOnboarding(cwd: string): Promise<string> {
+  const { session, realSessionId } = await startRpcSession(`__paseo__${randomUUID()}`, "", cwd);
+  await session.send({ type: "set_session_name", name: "Paseo 連線初始化" });
+  allowFileRoot(cwd);
+  if (await promptPaseoOnboarding(session, PASEO_ONBOARDING_PROMPT)) {
+    // Reopen from disk on continuation so the model also sees the saved request.
+    await session.shutdown();
+  }
+  invalidateSessionListCache();
+  return realSessionId;
+}
+
+function isDisabled(entry: unknown): boolean {
+  if (!entry || typeof entry !== "object") return false;
+  const lists = entry as Record<string, unknown>;
+  return ["extensions", "skills", "prompts", "themes"].every((key) => Array.isArray(lists[key]) && lists[key].length === 0);
+}
+
+/** Metadata discovery does not resolve/load resources or install packages. */
+export function configuredPaseoPackages(cwd: string, globalOnly = false): PaseoPackageRef[] {
+  const agentDir = getAgentDir();
+  const trusted = !globalOnly && getProjectTrustStatus(cwd, agentDir).trusted;
+  const settings = SettingsManager.create(cwd, agentDir, { projectTrusted: trusted });
+  const manager = new DefaultPackageManager({ cwd, agentDir, settingsManager: settings });
+  return manager.listConfiguredPackages().flatMap((pkg) => {
+    if (globalOnly && pkg.scope === "project") return [];
+    if (!pkg.installedPath) return [];
+    let root: string;
+    try {
+      root = paseoPackageRoot(pkg.installedPath);
+      readPaseoPackageManifest(root);
+    } catch { return []; }
+    const scope = pkg.scope === "project" ? "project" : "global";
+    const entries = scope === "project" ? settings.getProjectSettings().packages : settings.getGlobalSettings().packages;
+    const configured = entries?.find((entry) => (typeof entry === "string" ? entry : entry.source) === pkg.source);
+    return [{ source: pkg.source, scope, packageName: PASEO_PACKAGE_NAME, installedPath: root, disabled: isDisabled(configured) }];
+  });
+}
+
+export async function loadPaseoHostApi(pkg: PaseoPackageRef, allowDisabled = false): Promise<PaseoHostApi> {
+  const apiUrl = paseoHostApiUrl(pkg, allowDisabled);
+  const cached = runtimeState().apis.get(apiUrl);
+  if (cached) return cached;
+  const api = await import(/* webpackIgnore: true */ apiUrl) as PaseoHostApi;
+  if (!["lifecycle", "restore", "status", "diagnostics", "pair", "saveConfig"].every((name) => typeof (api as unknown as Record<string, unknown>)[name] === "function")) {
+    throw new Error("Paseo runtime API unavailable");
+  }
+  runtimeState().apis.set(apiUrl, api);
+  return api;
+}
+
+export async function applyPaseoPackageLifecycle(
+  action: PaseoLifecycleAction,
+  cwd: string,
+  before: PaseoPackageRef[],
+  after: PaseoPackageRef[],
+  successful: Pick<PaseoPackageRef, "source" | "scope">[],
+  preloaded?: PaseoHostApi,
+): Promise<PaseoLifecycleResult | undefined> {
+  const targets = paseoLifecycleTargets(action, before, after, successful);
+  let result: PaseoLifecycleResult | undefined;
+  for (const target of targets) {
+    try {
+      const packages = after.filter((pkg) => pkg.packageName === PASEO_PACKAGE_NAME);
+      const remaining = packages.find((pkg) => !pkg.disabled);
+      const api = remaining ? await loadPaseoHostApi(remaining) : preloaded ?? await loadPaseoHostApi(target, true);
+      if ((action === "disable" || action === "remove") && remaining) {
+        // Reconcile the remaining registration without clearing a manual Stop.
+        result = paseoLifecycleResult(await api.restore({ createOnboarding: () => createPaseoOnboarding(cwd) }));
+      } else {
+        result = await dispatchPaseoLifecycle(api, action, cwd, remaining ?? target, packages, () => createPaseoOnboarding(cwd));
+      }
+    } catch {
+      result = { error: "Paseo 整合服務尚未載入；請檢查插件安裝位置並開啟設定頁。" };
+    }
+  }
+  return result;
+}
+
+/** Once per process; project recovery is limited to an explicit existing cwd. */
+export function restorePaseoPlugin(): Promise<void> {
+  return runtimeState().restore ??= serializePluginPackageOperation(async () => {
+    let cwd = homedir();
+    let globalOnly = true;
+    const configuredCwd = process.env.PI_PASEO_CWD;
+    if (configuredCwd && isAbsolute(configuredCwd)) {
+      try {
+        if (statSync(configuredCwd).isDirectory()) {
+          cwd = configuredCwd;
+          globalOnly = false;
+        }
+      } catch { /* Missing or unreadable project: recover global packages only. */ }
+    }
+    const packages = configuredPaseoPackages(cwd, globalOnly);
+    const enabled = packages.find((pkg) => !pkg.disabled);
+    if (!enabled) return;
+    const api = await loadPaseoHostApi(enabled);
+    await api.restore({ createOnboarding: () => createPaseoOnboarding(cwd) });
+  }).catch(() => {
+    // Status/diagnostics expose a safe retry path; never log subprocess errors.
+    console.warn("[pi-web] Paseo startup recovery needs attention; open /paseo/setup.");
+  });
+}
