diff --git a/app/api/plugin-paseo/route.ts b/app/api/plugin-paseo/route.ts
new file mode 100644
index 0000000..3307fa4
--- /dev/null
+++ b/app/api/plugin-paseo/route.ts
@@ -0,0 +1,82 @@
+import { NextResponse } from "next/server";
+import { homedir } from "node:os";
+import { getAllowedFileRoots, isExistingFilePathAllowed } from "@/lib/file-access";
+import { hasJsonContentType, isApiRequestAllowed } from "@/lib/request-security";
+import { configuredPaseoPackages, createPaseoOnboarding, loadPaseoHostApi } from "@/lib/paseo-plugin";
+import { paseoLifecycleResult } from "@/lib/paseo-plugin-lifecycle";
+import { serializePluginPackageOperation } from "@/lib/plugin-package-lock";
+import { paseoDiagnosticChecks, paseoModelCatalog, paseoPublicStatus, readPaseoConfig, safePaseoPairUrl } from "@/lib/paseo-ui";
+
+export const dynamic = "force-dynamic";
+export const runtime = "nodejs";
+const headers = { "Cache-Control": "private, no-store", "Referrer-Policy": "no-referrer" };
+
+function response(value: unknown, status = 200) {
+  return NextResponse.json(value, { status, headers });
+}
+
+async function context(cwd: unknown) {
+  const directory = typeof cwd === "string" && cwd ? cwd : process.env.PI_PASEO_CWD || homedir();
+  const roots = await getAllowedFileRoots();
+  if (!isExistingFilePathAllowed(directory, roots)) return null;
+  const packages = configuredPaseoPackages(directory);
+  const target = packages.find((pkg) => !pkg.disabled) ?? packages[0];
+  if (!target) return null;
+  return { cwd: directory, packages, target, api: target.disabled ? null : await loadPaseoHostApi(target) };
+}
+
+export async function GET(req: Request) {
+  if (!isApiRequestAllowed(req)) return response({ error: "Untrusted API request" }, 403);
+  try {
+    const current = await context(new URL(req.url).searchParams.get("cwd"));
+    if (!current) return response({ error: "請先在插件設定安裝 Paseo，並選擇可存取的工作目錄。" }, 404);
+    return response(current.api ? paseoPublicStatus({ ...await current.api.status(), packageEnabled: true, packageInstalled: true }) : { phase: "disabled", packageEnabled: false, packageInstalled: true });
+  } catch {
+    return response({ error: "Paseo 狀態暫時無法取得；請檢查插件安裝與服務。" }, 503);
+  }
+}
+
+export async function POST(req: Request) {
+  if (!isApiRequestAllowed(req)) return response({ error: "Untrusted API request" }, 403);
+  if (!hasJsonContentType(req)) return response({ error: "Content-Type must be application/json" }, 415);
+  try {
+    const raw = await req.text();
+    if (raw.length > 16 * 1024) return response({ error: "Request too large" }, 413);
+    let body: Record<string, unknown>;
+    try { body = JSON.parse(raw); } catch { return response({ error: "Invalid JSON request" }, 400); }
+    if (!body || typeof body !== "object" || Array.isArray(body)) return response({ error: "Invalid request" }, 400);
+    if (!["status", "activate", "disable", "diagnose", "pair", "config", "models"].includes(String(body.action))) return response({ error: "Unsupported action" }, 400);
+    return await serializePluginPackageOperation(async () => {
+      const current = await context(body.cwd);
+      if (!current) return response({ error: "Paseo 插件尚未安裝，或工作目錄無法存取。" }, 404);
+      const { api, cwd, target, packages } = current;
+      if (!api) return response({ error: "請先在插件設定啟用 Paseo。" }, 409);
+      if (body.action === "status") return response(paseoPublicStatus(await api.status()));
+      if (body.action === "diagnose") return response({ checks: paseoDiagnosticChecks(await api.diagnostics()) });
+      if (body.action === "models") {
+        if (!["claude", "codex", "pi"].includes(String(body.provider))) return response({ error: "Unsupported provider" }, 400);
+        if (!api.listModels) return response({ error: "目前插件未提供模型目錄；請開啟 Paseo 選擇模型與模式。" }, 501);
+        return response(paseoModelCatalog(await api.listModels(String(body.provider)), String(body.provider)));
+      }
+      if (body.action === "pair") {
+        if (target.disabled) return response({ error: "請先在插件設定啟用 Paseo。" }, 409);
+        const result = await api.pair();
+        const url = safePaseoPairUrl(result.url);
+        if (!url) return response({ error: "Paseo 未提供有效的官方配對連結。" }, 502);
+        return response({ url, ...(typeof result.expiresAt === "string" && /^\d{4}-\d{2}-\d{2}T[\d:.]+Z$/.test(result.expiresAt) ? { expiresAt: result.expiresAt } : {}) });
+      }
+      if (body.action === "config") {
+        const config = readPaseoConfig(body.config);
+        if (!config) return response({ error: "設定只接受有效的顯示名稱。" }, 400);
+        await api.saveConfig(config);
+        return response(paseoPublicStatus(await api.status()));
+      }
+      if (body.action === "activate" && target.disabled) return response({ error: "請先在插件設定啟用 Paseo。" }, 409);
+      const result = await api.lifecycle({ action: body.action === "disable" ? "disable" : "enable", cwd, source: target.source, scope: target.scope, packages: body.action === "disable" ? [] : packages }, { createOnboarding: () => createPaseoOnboarding(cwd) });
+      return response(paseoLifecycleResult(result));
+    });
+  } catch {
+    // Do not return exception strings: CLI output can contain pairing secrets.
+    return response({ error: "Paseo 操作尚未完成；請檢查診斷並重試。" }, 503);
+  }
+}
