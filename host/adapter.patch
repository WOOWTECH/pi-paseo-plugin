diff --git a/app/paseo-web/[[...path]]/route.ts b/app/paseo-web/[[...path]]/route.ts
new file mode 100644
index 0000000..3087ee9
--- /dev/null
+++ b/app/paseo-web/[[...path]]/route.ts
@@ -0,0 +1,23 @@
+import { homedir } from "node:os";
+import { configuredPaseoPackages, loadPaseoHostApi } from "@/lib/paseo-plugin";
+import { isApiRequestHostAllowed } from "@/lib/request-security";
+
+export const dynamic = "force-dynamic";
+export const runtime = "nodejs";
+const headers = { "Cache-Control": "private, no-store", "Referrer-Policy": "no-referrer" };
+
+export async function GET(request: Request) {
+  if (!isApiRequestHostAllowed(request)) return new Response("Untrusted request", { status: 403, headers });
+  try {
+    const directory = process.env.PI_PASEO_CWD || homedir();
+    const pkg = configuredPaseoPackages(directory, !process.env.PI_PASEO_CWD).find((entry) => !entry.disabled);
+    if (!pkg) return new Response("請先在插件設定啟用 Paseo。", { status: 404, headers });
+    const api = await loadPaseoHostApi(pkg);
+    if (!api.web) return new Response("請更新 Paseo 插件以啟用修正版網頁。", { status: 503, headers });
+    return await api.web(request);
+  } catch {
+    return new Response("Paseo 網頁尚未就緒，請到 Pi Web 設定 > 插件檢查服務。", { status: 503, headers });
+  }
+}
+
+export const HEAD = GET;
diff --git a/app/paseo/setup/page.tsx b/app/paseo/setup/page.tsx
new file mode 100644
index 0000000..fa8d06c
--- /dev/null
+++ b/app/paseo/setup/page.tsx
@@ -0,0 +1,8 @@
+import { homedir } from "node:os";
+import { redirect } from "next/navigation";
+
+export default async function PaseoSetupPage({ searchParams }: { searchParams: Promise<{ cwd?: string }> }) {
+  const { cwd } = await searchParams;
+  const params = new URLSearchParams({ cwd: typeof cwd === "string" && cwd.startsWith("/") ? cwd : homedir(), settings: "plugins" });
+  redirect(`/?${params}`);
+}
